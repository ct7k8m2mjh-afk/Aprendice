 "divergencias": {
  "Pe8aa4f48": {
   "materia": "bio",
   "prova": "PUC-Campinas 2025 · questão 64",
   "conteudo": "B01.1 membrana plasmática e transporte passivo (tema B01 Citologia)",
   "motivo": "PUC-Campinas 2025 q64 (fibrose cística): a banca chega à letra oficial B, sustentada pelo texto. Mas a alternativa D (“quando a proteína transportadora […] é ativada por moléculas de ATP, a saída dos íons cloreto das células ocorre por transporte do tipo passivo”) descreve o que de fato ocorre no canal de cloro da fibrose cística (CFTR): é um canal aberto por ATP, e o cloreto sai a favor do gradiente, sem bombeamento. Para escrever que D está errada seria preciso afirmar que todo transporte com ATP é ativo, o que não vale para esse canal. Questão com duas alternativas defensáveis; não publicada.",
   "lote": "bio-0003",
   "data": "2026-11-11"
  },
  "Pf50ed6de": {
   "materia": "bio",
   "prova": "UFPR 2024 1ª fase · questão 29",
   "conteudo": "B03.5 fotossíntese: fase fotoquímica e ciclo de Calvin (tema B03 Metabolismo energético)",
   "motivo": "UFPR 2024, 1ª fase, questão 29: o gabarito oficial é C (absorção de CO₂ → fixação do carbono → síntese de glicose → liberação de O₂), que põe a liberação de O₂ no fim. O O₂ é liberado na fase fotoquímica, que fornece ATP e NADPH para o ciclo de Calvin; por essa ordem, a alternativa D (liberação de O₂ → absorção de CO₂ → fixação do carbono → síntese de glicose) também se sustenta. Há duas alternativas defensáveis; não publicar sem decisão do dono.",
   "lote": "bio-0007",
   "data": "2026-11-11"
  },
  "P15367bf9": {
   "materia": "bio",
   "prova": "UDESC 2023 Inverno 2023.2 · questão 22",
   "conteudo": "B05.5 regulação da expressão gênica: fatores de transcrição e diferenciação celular (tema B05 Genética molecular)",
   "motivo": "Gabarito oficial B (totipotentes), mas o raciocínio leva a E (pluripotentes): a definição de livro para a célula-tronco capaz de se diferenciar em qualquer tipo de célula do corpo adulto é a pluripotente; a totipotente, além disso, forma os anexos embrionários e um organismo completo. As duas categorias atendem ao enunciado, e a questão fica com duas respostas defensáveis.",
   "lote": "bio-0011",
   "data": "2026-11-12"
  }
 }
