 "pendentes": {
  "P4b4e462f": {
   "materia": "ing",
   "prova": "UPE 2024 SSA3 · questão 26",
   "conteudo": "I01.1 tema e ideia principal (tema I01 Leitura e interpretação de textos)",
   "motivo": "O 4º parágrafo, que a questão pede, está cortado no print e no texto da prova: só aparece a primeira linha (“It’s not the place that is special but what we bring to it and crucially how we interact with it”), encoberta pela moldura do parágrafo 5. A alternativa C (“não é preciso ir muito longe para obter uma nova perspectiva”) depende do resto do parágrafo, que não está disponível; sem ele não dá para confirmar a resposta nem desmentir as outras com o texto.",
   "lote": "ing-0002",
   "data": "2026-11-11"
  },
  "P08a901b1": {
   "materia": "ing",
   "prova": "Acafe 2021 Verão · questão 15",
   "conteudo": "I01.1 tema e ideia principal (tema I01 Leitura e interpretação de textos)",
   "motivo": "O texto que a questão pede (“The text above”, o trecho do anúncio da Apple de 1997) não está no print da questão 15 nem em outro print da prova Acafe 2021 Verão; os prints das questões 15 e 16 mostram só os enunciados. Sem o texto, não dá para provar a resposta pelo trecho nem desmentir as alternativas.",
   "lote": "ing-0003",
   "data": "2026-11-11"
  },
  "P9740c674": {
   "materia": "ing",
   "prova": "Acafe 2022 Inverno · questão 15",
   "conteudo": "I01.1 tema e ideia principal (tema I01 Leitura e interpretação de textos)",
   "motivo": "A questão pede o primeiro parágrafo (linhas 1 a 3) do texto da Acafe 2022 Inverno, mas o texto não está no print da questão 15 nem em outro print da prova. Sem o parágrafo, não dá para confirmar a alternativa B nem desmentir as outras.",
   "lote": "ing-0003",
   "data": "2026-11-11"
  },
  "P0fea2fcf": {
   "materia": "ing",
   "prova": "Acafe 2026 Inverno · questão 15",
   "conteudo": "I01.1 tema e ideia principal (tema I01 Leitura e interpretação de textos)",
   "motivo": "A questão pede o “text 1” sobre o anúncio da OMS (Acafe 2026 Inverno), mas o texto não está no print da questão 15 nem em outro print da prova; o print mostra só o enunciado e as alternativas. As quatro alternativas citam fatos que precisariam ser conferidos no texto.",
   "lote": "ing-0003",
   "data": "2026-11-11"
  }
 },
 "divergencias": {
  "P855bb53e": {
   "materia": "ing",
   "prova": "Mackenzie 2026 2026/2 – 15/07 · questão 11",
   "conteudo": "I01.1 tema e ideia principal (tema I01 Leitura e interpretação de textos)",
   "motivo": "O raciocínio leva à alternativa B, e não à A do gabarito registrado. O texto é uma crítica (review) do filme de ficção The Secret Agent, de Kleber Mendonça Filho: “Kleber Mendonça Filho’s study of a man attempting to escape corrupt politics is a tremendous, novelistic study of corruption in high and low places” e “visual brilliance”, exatamente o que B diz. A alternativa A fala de “historical accuracy of documentary”, mas o texto não trata de documentário nem de precisão histórica. Conferir o gabarito oficial do Mackenzie 2026/2 (15/07), questão 11; pode ser erro na captura do gabarito.",
   "lote": "ing-0002",
   "data": "2026-11-11"
  }
 }
