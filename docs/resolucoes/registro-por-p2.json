 "pendentes": {
  "P6c2f77f0": {
   "materia": "por",
   "prova": "UFT 2024 Vestibular 2024/1 · questão 7",
   "conteudo": "P08.1 sujeito e predicado, inclusive sujeito oculto e oração sem sujeito (tema P08 Período simples)",
   "motivo": "anular: o gabarito definitivo D exige que a afirmativa III esteja correta, mas “maltratando uma velhinha” não é predicado nominal. “Estão maltratando” é locução verbal (auxiliar estar + gerúndio do verbo transitivo direto maltratar), e “uma velhinha” é objeto direto: o predicado é verbal, e não há verbo de ligação nem predicativo. Corretas pelos fatos: só a IV (I é falsa: sujeito indeterminado; II é falsa: “uma velhinha” é objeto direto). Nenhuma alternativa reúne só a IV. Busca na web sem errata nem resolução publicada.",
   "lote": "por-p2-0001",
   "data": "2026-11-19"
  },
  "Pcfeab3fb": {
   "materia": "por",
   "prova": "Fema 2022 Processo Seletivo 2022 · questão 23",
   "conteudo": "P10.2 regência verbal e nominal, e crase (tema P10 Norma e emprego)",
   "motivo": "anular: o gabarito oficial B ('a - a - às') põe crase depois de 'após', que já é preposição; crase é a fusão da preposição 'a' com o artigo 'a', e depois de outra preposição ('após', 'desde', 'perante', 'entre') só cabe o artigo: 'após as 18 horas'. A resposta conforme a norma é A ('a - a - as': 'Informe a todos' — pronome masculino, sem artigo; 'a partir' — antes de verbo, sem crase; 'após as 18 horas'). Procurei errata na web e não achei.",
   "lote": "por-p2-0003",
   "data": "2026-11-19"
  }
 },
 "divergencias": {
  "P2b2aa288": {
   "materia": "por",
   "prova": "UFRR 2026 Vestibular 2026 – Prova Integral · questão 9",
   "conteudo": "P10.1 concordância verbal e nominal (tema P10 Norma e emprego)",
   "motivo": "Minha letra é D, resolvida às cegas antes de ver o preliminar; o gabarito preliminar é A. A alternativa A diz que o verbo 'sabendo' não impede a próclise, mas quem atrai o pronome é o 'que'; e apresenta 'estou me perseguindo' como a forma adequada, deixando de fora 'que me estou perseguindo'. D é a única que admite as duas colocações aceitas na locução com gerúndio (próclise ao auxiliar e ênclise ao gerúndio). Um resultado de busca na web indica que o Edital 93/25-CPV (gabarito oficial pós-recursos) traz a questão 9 da E3/PI como anulada, mas o PDF não abriu daqui (503 e conexão recusada): não confirmado.",
   "lote": "por-p2-0003",
   "data": "2026-11-19"
  }
