 "divergencias": {
  "P03aa1d35": {
   "materia": "qui",
   "prova": "Famerp 2021 · questão 51",
   "conteudo": "Q01.1 modelos atômicos e partículas subatômicas (tema Q01 Átomo e tabela periódica)",
   "motivo": "Famerp 2021 q51 (lâmpadas de neon): a resolução independente deu A (Rutherford e Bohr) antes de ver o gabarito; o oficial é E (Thomson e Bohr). A emissão de luz com cor característica só é explicada pelo modelo de Bohr; o segundo nome do par depende de interpretação (Thomson, pela natureza elétrica da matéria e pelos elétrons no tubo; ou Rutherford, pelo modelo de Rutherford-Bohr). O conferente vê uma leitura que sustenta E (tubo de gás rarefeito com elétrons lembra Thomson), mas não inequívoca. Não publicada.",
   "lote": "qui-0004",
   "data": "2026-11-11"
  },
  "P3220cf43": {
   "materia": "qui",
   "prova": "UECE 2021 2021.1 – 2ª fase · questão 118",
   "conteudo": "Q02.4 forças intermoleculares e ponto de fusão, ebulição e solubilidade (tema Q02 Ligações e forças entre moléculas)",
   "motivo": "UECE 2021.1, 2ª fase, questão 118: o gabarito oficial é A (tensão superficial), mas a alternativa D (ligações de hidrogênio) também se sustenta, pois essas ligações atuam entre a água e a proteína da gelatina. Além disso, o enunciado atribui a Samuel Kistler, na década de 1930, a invenção da gelatina; ele é conhecido pela invenção do aerogel. Enunciado com erro de fato e duas alternativas defensáveis; não publicar sem decisão do dono.",
   "lote": "qui-0009",
   "data": "2026-11-11"
  },
  "P994714e6": {
   "materia": "qui",
   "prova": "UFU 2025 1ª fase · questão 73",
   "conteudo": "Q03.5 substância pura e mistura, alotropia e processos de separação de misturas (tema Q03 Funções inorgânicas e nox)",
   "motivo": "Gabarito oficial B, mas a alternativa C também é quimicamente defensável: vários flavonoides e polifenóis são pouco solúveis em água, e isso limita a eficiência da infusão. B descreve o mecanismo da extração (dissolução e difusão, conforme a polaridade), e C faz uma afirmação cautelosa e verdadeira. A questão fica com duas alternativas aceitáveis.",
   "lote": "qui-0013",
   "data": "2026-11-12"
  }
 }
