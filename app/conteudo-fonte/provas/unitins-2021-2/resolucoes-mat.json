 "P0288ac33": {
  "n": "14",
  "conceito": "Substituir no modelo de meia-vida m(t) = 120 · 2^(−t/6).",
  "equivocos": {
   "A": "M06.5:numero-de-meias-vidas-errado",
   "B": "M06.5:numero-de-meias-vidas-errado",
   "C": "M06.5:dividiu-pelo-numero-de-meias-vidas",
   "E": "M06.5:decaimento-linear"
  },
  "resolucao": {
   "antes": {
    "texto": "Meia-vida de 6 horas: em 24 horas cabem 4 meias-vidas. Na fórmula, o expoente −t/6 vale −4, e 120 é dividido por 2⁴ = 16.",
    "formulas": [
     "m(t) = 120 · 2^(−t/6)"
    ],
    "simbolos": [
     [
      "m(t)",
      "massa no organismo, em mg"
     ],
     [
      "t",
      "tempo em horas"
     ]
    ]
   },
   "pista": "Calcule o expoente −t/6 com t = 24.",
   "passos": [
    {
     "faz": "Calcule o expoente",
     "conta": "−t/6 = −24/6 = −4",
     "porque": "t = 24 horas.",
     "tipo": "calcular"
    },
    {
     "faz": "Calcule a potência",
     "conta": "2⁻⁴ = 1/16",
     "porque": "Expoente negativo é o inverso.",
     "tipo": "calcular"
    },
    {
     "faz": "Multiplique pela dose",
     "conta": "120 × 1/16 = 7,5 mg",
     "porque": "120 ÷ 16 = 7,5.",
     "tipo": "calcular"
    },
    {
     "faz": "Ligue à alternativa",
     "conta": "7,5 mg → alternativa D",
     "porque": "Quantidade após 24 horas.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa D — 7,5 mg",
   "checagem": "Metades seguidas: 120 → 60 (6 h) → 30 (12 h) → 15 (18 h) → 7,5 mg (24 h). Fecha.",
   "erradas": {
    "A": "60 sai de aplicar só uma meia-vida (6 horas).",
    "B": "15 sai de parar em 18 horas, três meias-vidas.",
    "C": "30 sai de parar em 12 horas, duas meias-vidas, ou de fazer 120 ÷ 4.",
    "E": "90 sai de tirar só 1/4 de 120 (120 − 30 = 90); o certo é dividir por 2 quatro vezes: 120 · 2⁻⁴ = 7,5 mg."
   },
   "armadilha": "Dividir 120 pelo número de meias-vidas (÷ 4 = 30) em vez de dividir por 2 quatro vezes.",
   "alerta": "",
   "essencial": {
    "pede": "A massa do fármaco após 24 horas.",
    "chave": "120 · 2^(−24/6) = 120/16 = 7,5 mg.",
    "cuidado": "Quatro meias-vidas é dividir por 16, não por 4."
   }
  },
  "caminhos": [
   {
    "nome": "metades",
    "ideia": "Divida 120 por 2 a cada 6 horas: 60, 30, 15, 7,5."
   }
  ],
  "quadro": [
   {
    "linha": "m(24) = 120 · 2^(−24/6)",
    "nota": "substitui"
   },
   {
    "linha": "m(24) = 120 · 2⁻⁴",
    "nota": "expoente −4"
   },
   {
    "linha": "m(24) = 120/16",
    "nota": "2⁴ = 16"
   },
   {
    "linha": "m(24) = 7,5",
    "nota": "mg"
   }
  ],
