 "P7c5b5677": {
  "n": "17",
  "conceito": "Potência de expressão com radicais: quadrado de quadrado.",
  "equivocos": {
   "B": "M01.2:termo-do-meio-incompleto",
   "C": "M01.2:sem-origem-identificada",
   "D": "M01.2:sem-origem-identificada",
   "E": "M01.2:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "x⁴ = (x²)². Calcule primeiro x² com o quadrado da diferença e depois eleve o resultado ao quadrado de novo.",
    "formulas": [
     "(a − b)² = a² − 2ab + b²",
     "√5 · √2 = √10"
    ],
    "simbolos": []
   },
   "pista": "Calcule x² antes; o que aparece no lugar de √5 · √2?",
   "passos": [
    {
     "faz": "x²",
     "conta": "x² = (5 − 2√10 + 2)/4 = (7 − 2√10)/4",
     "porque": "(√5 − √2)² = 5 − 2√10 + 2; o 2 do denominador vira 4.",
     "tipo": "calcular"
    },
    {
     "faz": "x⁴",
     "conta": "x⁴ = (7 − 2√10)²/16 = (49 − 28√10 + 40)/16",
     "porque": "(2√10)² = 4 · 10 = 40; 2 · 7 · 2√10 = 28√10.",
     "tipo": "calcular"
    },
    {
     "faz": "Somar",
     "conta": "x⁴ = (89 − 28√10)/16 → alternativa A",
     "porque": "49 + 40 = 89.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa A — (89 − 28√10)/16",
   "checagem": "Com aproximações: √5 ≈ 2,2361 e √2 ≈ 1,4142, então x ≈ 0,4110 e x⁴ ≈ 0,0285. E (89 − 28 · 3,1623)/16 ≈ (89 − 88,544)/16 ≈ 0,0285. As outras dão valores bem maiores (B ≈ 4,77). Confere.",
   "erradas": {
    "B": "(89 − 4√10)/16 ≈ 4,77, muito maior que x⁴ ≈ 0,0285: o termo do meio é 28√10, não 4√10.",
    "C": "(89 − 4√10)/8 ≈ 9,54, longe de x⁴ ≈ 0,0285.",
    "D": "(41 − 4√10)/8 ≈ 3,54, longe de x⁴ ≈ 0,0285.",
    "E": "(41 − 4√10)/16 ≈ 1,77, longe de x⁴ ≈ 0,0285."
   },
   "armadilha": "Calcular (2√10)² como 2 · 10 = 20 ou esquecer o fator 7 no termo do meio.",
   "alerta": "",
   "essencial": {
    "pede": "x⁴.",
    "chave": "x² = (7 − 2√10)/4, depois ao quadrado.",
    "cuidado": "(2√10)² = 40 e o termo do meio é 2 · 7 · 2√10."
   }
  },
  "caminhos": [
   {
    "nome": "binômio de Newton",
    "ideia": "Seja u = √5 e v = √2: x⁴ = (u − v)⁴/16. (u − v)⁴ = u⁴ − 4u³v + 6u²v² − 4uv³ + v⁴ = 25 − 4 · 5√10 + 6 · 10 − 4 · 2√10 + 4 = 89 − 28√10."
   }
  ],
  "quadro": [
   {
    "linha": "x² = (7 − 2√10)/4",
    "nota": "primeiro quadrado"
   },
   {
    "linha": "(49 − 28√10 + 40)/16",
    "nota": "segundo quadrado"
   },
   {
    "linha": "(89 − 28√10)/16",
    "nota": "resposta"
   }
  ],
  "visual": null,
  "fontes": [],
  "aprovada": true,
