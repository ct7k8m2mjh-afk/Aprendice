 "Pea7e1112": {
  "n": "26",
  "conceito": "Resto na divisão por 9 pela soma dos algarismos.",
  "equivocos": {
   "A": "M01.4:sem-origem-identificada",
   "B": "M01.4:sem-origem-identificada",
   "C": "M01.4:sem-origem-identificada",
   "D": "M01.4:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "Um número e a soma dos seus algarismos deixam o mesmo resto na divisão por 9. E o resto de um produto é o resto do produto dos restos.",
    "formulas": [
     "n ≡ soma dos algarismos (mod 9)",
     "resto(a · b) = resto(resto(a) · resto(b))"
    ],
    "simbolos": []
   },
   "pista": "Ache o resto de cada fator por 9 somando os algarismos.",
   "passos": [
    {
     "faz": "Primeiro fator",
     "conta": "1 + 3 + 8 + 4 + 1 + 2 = 19 → resto 1",
     "porque": "19 = 18 + 1.",
     "tipo": "calcular"
    },
    {
     "faz": "Segundo fator",
     "conta": "2 + 5 + 6 + 3 + 5 + 5 = 26 → resto 8",
     "porque": "26 = 18 + 8.",
     "tipo": "calcular"
    },
    {
     "faz": "Produto",
     "conta": "1 · 8 = 8 → resto 8 → alternativa E",
     "porque": "Resto do produto.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa E — 8",
   "checagem": "Divida cada fator: 138 412 = 9 · 15 379 + 1 (9 · 15 379 = 138 411) e 256 355 = 9 · 28 483 + 8 (9 · 28 483 = 256 347). O produto é (9k + 1)(9m + 8) = 9(...) + 8. Confere.",
   "erradas": {
    "A": "O produto é 35 482 608 260, com soma dos algarismos 44 = 4 · 9 + 8: o resto é 8, não 7.",
    "B": "O produto é 35 482 608 260, com soma dos algarismos 44 = 4 · 9 + 8: o resto é 8, não 5.",
    "C": "O produto é 35 482 608 260, com soma dos algarismos 44 = 4 · 9 + 8: o resto é 8, não 6.",
    "D": "O produto é 35 482 608 260, com soma dos algarismos 44 = 4 · 9 + 8: o resto é 8, não 4."
   },
   "armadilha": "Somar os restos (1 + 8 = 9 → 0) em vez de multiplicar.",
   "alerta": "",
   "essencial": {
    "pede": "Resto do produto por 9.",
    "chave": "Restos 1 e 8; produto 8.",
    "cuidado": "Produto de restos, não soma."
   }
  },
  "caminhos": [
   {
    "nome": "resto −1",
    "ideia": "256 355 deixa resto 8 ≡ −1; 138 412 deixa resto 1. Produto ≡ 1 · (−1) = −1 ≡ 8."
   }
  ],
  "quadro": [
   {
    "linha": "resto 1",
    "nota": "138 412"
   },
   {
    "linha": "resto 8",
    "nota": "256 355"
   },
   {
    "linha": "1 · 8 = 8",
    "nota": "resposta"
   }
  ],
