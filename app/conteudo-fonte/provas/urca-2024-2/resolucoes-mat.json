 "P68065288": {
  "n": "29",
  "conceito": "Regra de três composta com fração do trabalho.",
  "equivocos": {
   "A": "M02.2:sem-origem-identificada",
   "C": "M02.2:esqueceu-a-metade",
   "D": "M02.2:sem-origem-identificada",
   "E": "M02.2:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "Calcule quantas \"operário-horas\" correspondem a 2/3 do trabalho. O resto é 1/3; a metade do resto é 1/6, que é 1/4 de 2/3. Depois divida pelas operário-dias disponíveis.",
    "formulas": [
     "trabalho ∝ operários · dias · horas"
    ],
    "simbolos": []
   },
   "pista": "1/6 do trabalho é que fração de 2/3 do trabalho?",
   "passos": [
    {
     "faz": "2/3 do trabalho",
     "conta": "18 · 6 · 8 = 864 operário-horas",
     "porque": "Dado.",
     "tipo": "calcular"
    },
    {
     "faz": "Metade do resto",
     "conta": "(1 − 2/3)/2 = 1/6 = (1/4) · (2/3)",
     "porque": "Fração pedida.",
     "tipo": "calcular"
    },
    {
     "faz": "Operário-horas",
     "conta": "864/4 = 216",
     "porque": "Para 1/6.",
     "tipo": "calcular"
    },
    {
     "faz": "Horas por dia",
     "conta": "216 ÷ (24 · 4) = 2,25 h = 2 h 15 min → alternativa B",
     "porque": "24 operários, 4 dias.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa B — 2h15min",
   "checagem": "Volte: 24 · 4 · 2,25 = 216 operário-horas; 216 é 1/4 de 864, e 864 corresponde a 2/3; então 216 corresponde a 1/6 = metade do 1/3 restante. Confere.",
   "erradas": {
    "A": "2 h dariam 192 operário-horas, menos que as 216 necessárias.",
    "C": "4 h 30 min dariam 432 operário-horas: é o resto inteiro (1/3), esquecendo o \"metade\".",
    "D": "4 h dariam 384 operário-horas, nem 1/6 nem 1/3 do trabalho.",
    "E": "3 h 30 min dariam 336 operário-horas, mais que as 216."
   },
   "armadilha": "Esquecer que é só a metade do resto e calcular para o 1/3 inteiro (4 h 30 min).",
   "alerta": "",
   "essencial": {
    "pede": "Horas por dia.",
    "chave": "1/6 do trabalho = 216 operário-horas; 216/96 = 2,25 h.",
    "cuidado": "0,25 h = 15 min."
   }
  },
  "caminhos": [
   {
    "nome": "regra de três composta",
    "ideia": "2/3 — 18 op — 6 d — 8 h; 1/6 — 24 op — 4 d — x. x = 8 · (1/6)/(2/3) · (18/24) · (6/4) = 8 · (1/4) · (3/4) · (3/2) = 2,25 h."
   }
  ],
  "quadro": [
   {
    "linha": "864 → 2/3",
    "nota": "dado"
   },
   {
    "linha": "216 → 1/6",
    "nota": "pedido"
   },
   {
    "linha": "2,25 h = 2 h 15 min",
    "nota": "resposta"
   }
  ],
  "visual": null,
  "fontes": [],
