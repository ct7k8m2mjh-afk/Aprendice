{
 "Ped0907b5": {
  "n": "23",
  "conceito": "Números mistos, dízima periódica, raízes e fração irredutível.",
  "equivocos": {
   "A": "M01.1:respondeu-p",
   "B": "M01.1:sem-origem-identificada",
   "D": "M01.1:sem-origem-identificada",
   "E": "M01.1:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "Transforme cada parte em fração: números mistos (2 1/3 = 7/3), dízima (2,333... = 7/3) e raízes exatas (√12321 = 111; 14 + 111 = 125; raiz cúbica de 125 = 5). Some tudo numa só fração p/q, irredutível.",
    "formulas": [
     "a b/c = (a · c + b)/c",
     "2,333... = 2 + 1/3"
    ],
    "simbolos": [
     [
      "p/q",
      "fração irredutível"
     ]
    ]
   },
   "pista": "√12321 é um número inteiro; tente 111.",
   "passos": [
    {
     "faz": "Numerador da fração grande",
     "conta": "2 1/3 + 1 1/6 = 7/3 + 7/6 = 21/6 = 7/2",
     "porque": "Denominador 6.",
     "tipo": "calcular"
    },
    {
     "faz": "Denominador da fração grande",
     "conta": "4 1/5 − 1/2 = 21/5 − 1/2 = 37/10",
     "porque": "Denominador 10.",
     "tipo": "calcular"
    },
    {
     "faz": "Fração grande",
     "conta": "(7/2) ÷ (37/10) = 70/74 = 35/37",
     "porque": "Multiplica pelo inverso.",
     "tipo": "calcular"
    },
    {
     "faz": "Raiz",
     "conta": "√12321 = 111; ∛(14 + 111) = ∛125 = 5",
     "porque": "111² = 12321.",
     "tipo": "calcular"
    },
    {
     "faz": "Somar",
     "conta": "35/37 + 7/3 + 5 = (105 + 259 + 555)/111 = 919/111",
     "porque": "mmc(37, 3) = 111.",
     "tipo": "calcular"
    },
    {
     "faz": "p − q",
     "conta": "919 − 111 = 808 → alternativa C",
     "porque": "919 e 111 = 3 · 37 não têm fator comum.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa C — 808",
   "checagem": "Em decimal: 35/37 ≈ 0,946; 2,333... + 5 = 7,333...; soma ≈ 8,279. E 919/111 ≈ 8,279. Além disso, 919 não é divisível por 3 (9 + 1 + 9 = 19) nem por 37 (37 · 24 = 888, 37 · 25 = 925), então p/q está irredutível. Confere.",
   "erradas": {
    "A": "919 é p, não p − q.",
    "B": "909 daria q = 10 com p = 919; o denominador é 111.",
    "D": "819 não confere: p/q = 919/111 é irredutível e dá p − q = 919 − 111 = 808.",
    "E": "929 não confere: p − q = 808; 929 seria maior que o próprio p."
   },
   "armadilha": "Responder p (919) e esquecer de subtrair q.",
   "alerta": "",
   "essencial": {
    "pede": "p − q.",
    "chave": "Tudo vira fração: 35/37 + 7/3 + 5 = 919/111.",
    "cuidado": "Confira se p/q está irredutível antes de subtrair."
   }
  },
  "caminhos": [
   {
    "nome": "somar as partes inteiras antes",
    "ideia": "A expressão é 35/37 + 2 + 1/3 + 5 = 7 + 35/37 + 1/3. Como 35/37 + 1/3 = (105 + 37)/111 = 142/111, p/q = 7 + 142/111 = (777 + 142)/111 = 919/111; p − q = 808."
   }
  ],
  "quadro": [
   {
    "linha": "35/37",
    "nota": "fração grande"
   },
   {
    "linha": "7/3",
    "nota": "dízima"
   },
   {
    "linha": "5",
    "nota": "raiz"
   },
   {
    "linha": "919/111",
    "nota": "p/q"
   },
   {
    "linha": "808",
    "nota": "p − q"
   }
  ],
  "visual": null,
  "fontes": [],
  "aprovada": true,
  "revisao": {
   "lentes": [
    "resolvedor-autoconferencia",
    "conferente-fatos-e-didatica"
   ],
   "data": "2026-11-12",
   "lote": "mat-0043"
  }
