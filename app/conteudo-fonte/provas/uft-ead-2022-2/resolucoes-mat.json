{
 "P2446d7b3": {
  "n": "11",
  "conceito": "Expressões numéricas com parênteses, colchetes e frações.",
  "equivocos": {
   "A": "M01.1:dobrou-duas-vezes",
   "B": "M01.1:sem-origem-identificada",
   "D": "M01.1:esqueceu-o-dobro"
  },
  "resolucao": {
   "antes": {
    "texto": "Resolva primeiro o que está dentro dos parênteses, depois os colchetes; a divisão final vira fração.",
    "formulas": [
     "ordem: parênteses → colchetes → divisão"
    ],
    "simbolos": []
   },
   "pista": "Calcule a e b separados, em forma de fração, antes de somar.",
   "passos": [
    {
     "faz": "Calcular a",
     "conta": "(3 + 1) ÷ [(3 · 2) + 1] = 4 ÷ 7 = 4/7",
     "porque": "Parênteses e colchetes primeiro.",
     "tipo": "calcular"
    },
    {
     "faz": "Calcular b",
     "conta": "[(3 · 7) − 1] ÷ [2 + (3 · 4)] = 20 ÷ 14 = 10/7",
     "porque": "Mesma ordem.",
     "tipo": "calcular"
    },
    {
     "faz": "Somar",
     "conta": "4/7 + 10/7 = 14/7 = 2",
     "porque": "Mesmo denominador.",
     "tipo": "calcular"
    },
    {
     "faz": "Dobro",
     "conta": "2 · 2 = 4 → alternativa C",
     "porque": "O que se pede.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa C — 4",
   "checagem": "Em decimal: a = 4 ÷ 7 ≈ 0,571 e b = 20 ÷ 14 ≈ 1,429; a + b ≈ 2,000, e o dobro é 4. Confere.",
   "erradas": {
    "A": "8 é o dobro de 4, ou seja, dobrou duas vezes.",
    "B": "6 não sai de a + b = 2; seria a + b = 3.",
    "D": "2 é a + b; faltou tomar o dobro."
   },
   "armadilha": "Responder a + b em vez do dobro de a + b.",
   "alerta": "",
   "essencial": {
    "pede": "2(a + b).",
    "chave": "a = 4/7, b = 10/7.",
    "cuidado": "Leia até o fim: é o dobro."
   }
  },
  "caminhos": [
   {
    "nome": "dobro antes",
    "ideia": "2(a + b) = 2a + 2b = 8/7 + 20/7 = 28/7 = 4."
   }
  ],
  "quadro": [
   {
    "linha": "a = 4/7",
    "nota": "conta"
   },
   {
    "linha": "b = 10/7",
    "nota": "conta"
   },
   {
    "linha": "2(a + b) = 4",
    "nota": "resposta"
   }
  ],
  "visual": null,
  "fontes": [],
