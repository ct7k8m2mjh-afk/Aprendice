 "P100526cb": {
  "n": "13",
  "conceito": "Discriminante Δ = b² − 4ac com coeficiente desconhecido.",
  "equivocos": {
   "A": "M04.2:valor-que-nao-fecha",
   "C": "M04.2:valor-que-nao-fecha",
   "D": "M04.2:valor-que-nao-fecha"
  },
  "resolucao": {
   "antes": {
    "texto": "Na equação ax² − 4x − 6 = 0, os coeficientes são a, b = −4 e c = −6. Escreva Δ com eles e iguale a 64.",
    "formulas": [
     "Δ = b² − 4ac"
    ],
    "simbolos": [
     [
      "Δ",
      "discriminante"
     ]
    ]
   },
   "pista": "Cuidado com os sinais de b e de c ao montar Δ.",
   "passos": [
    {
     "faz": "Monte Δ",
     "conta": "Δ = (−4)² − 4 · a · (−6) = 16 + 24a",
     "porque": "Menos vezes menos dá mais: −4a · (−6) = +24a.",
     "tipo": "calcular"
    },
    {
     "faz": "Iguale a 64",
     "conta": "16 + 24a = 64 → 24a = 48 → a = 2",
     "porque": "O discriminante dado é 64.",
     "tipo": "calcular"
    },
    {
     "faz": "Responda",
     "conta": "a = 2 → alternativa B",
     "porque": "É o valor de a.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa B — 2",
   "checagem": "Com a = 2: 2x² − 4x − 6 = 0, Δ = 16 + 48 = 64. Raízes (4 ± 8)/4: 3 e −1, que de fato satisfazem 2x² − 4x − 6 = 0.",
   "erradas": {
    "A": "1 não confere: Δ = 16 + 24 = 40.",
    "C": "3 não confere: Δ = 16 + 72 = 88.",
    "D": "4 não confere: Δ = 16 + 96 = 112."
   },
   "armadilha": "Errar o sinal de −4ac: com c = −6, o termo fica +24a, e quem escreve 16 − 24a não acha valor positivo.",
   "alerta": "",
   "essencial": {
    "pede": "O valor de a.",
    "chave": "Δ = 16 + 24a = 64, a = 2.",
    "cuidado": "−4 · a · (−6) = +24a."
   }
  },
  "caminhos": [
   {
    "nome": "testar alternativas",
    "ideia": "Calcule 16 + 24a para cada alternativa; só a = 2 dá 64."
   }
  ],
  "quadro": [
   {
    "linha": "(−4)² − 4 · a · (−6) = 64",
    "nota": "Δ = 64"
   },
   {
    "linha": "16 + 24a = 64",
    "nota": "sinais"
   },
   {
    "linha": "24a = 48",
    "nota": "o 16 passa subtraindo"
   },
   {
    "linha": "a = 48/24 = 2",
    "nota": "o 24 passa dividindo"
   }
  ],
  "visual": null,
  "fontes": [],
  "aprovada": true,
  "revisao": {
   "lentes": [
    "resolvedor-autoconferencia",
    "conferente-fatos-e-didatica"
   ],
   "data": "2026-11-13",
   "lote": "mat-0051"
  }
 },
 "Pf3f9eda4": {
  "n": "14",
  "conceito": "Proporção com incógnita nos denominadores que recai em equação do 2.º grau.",
  "equivocos": {
   "B": "M04.2:valor-que-nao-fecha",
   "C": "M04.2:sinal-das-raizes-trocado",
   "D": "M04.2:valor-que-nao-fecha"
  },
  "resolucao": {
   "antes": {
    "texto": "Numa proporção, produto dos meios é igual ao produto dos extremos. Multiplique em cruz e caia numa equação do 2.º grau; depois confira a condição x ≠ 2.",
    "formulas": [
     "a/b = c/d ⇒ a · d = b · c"
    ],
    "simbolos": []
   },
   "pista": "Multiplique em cruz.",
   "passos": [
    {
     "faz": "Multiplique em cruz",
     "conta": "(x − 1)(x − 2) = 2 · 3 = 6",
     "porque": "Produto dos extremos igual ao dos meios.",
     "tipo": "calcular"
    },
    {
     "faz": "Desenvolva",
     "conta": "x² − 3x + 2 = 6 → x² − 3x − 4 = 0",
     "porque": "Iguale a zero para resolver.",
     "tipo": "calcular"
    },
    {
     "faz": "Ache as raízes",
     "conta": "soma 3 e produto −4 → x = 4 ou x = −1",
     "porque": "4 + (−1) = 3 e 4 · (−1) = −4.",
     "tipo": "calcular"
    },
    {
     "faz": "Confira e responda",
     "conta": "nenhuma é 2 → S = {−1, 4} → alternativa A",
     "porque": "As duas respeitam x ≠ 2.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa A — {−1, 4}",
   "checagem": "x = 4: (4 − 1)/2 = 3/2 e 3/(4 − 2) = 3/2. x = −1: −2/2 = −1 e 3/(−3) = −1. Ambos fecham.",
   "erradas": {
    "B": "{−1, 3} não confere: x = 3 dá 2/2 = 1 de um lado e 3/1 = 3 do outro.",
    "C": "{1, −4} sai de trocar o sinal do termo em x: x² + 3x − 4 = 0 tem raízes 1 e −4.",
    "D": "{1, −3} não confere: x = 1 dá 0 de um lado e 3/(−1) = −3 do outro."
   },
   "armadilha": "Trocar o sinal das raízes na soma e produto: soma 3 dá 4 e −1, não −4 e 1.",
   "alerta": "",
   "essencial": {
    "pede": "O conjunto solução.",
    "chave": "(x − 1)(x − 2) = 6, x² − 3x − 4 = 0, raízes 4 e −1.",
    "cuidado": "Soma das raízes = −b/a = 3."
   }
  },
  "caminhos": [
   {
    "nome": "Bhaskara",
    "ideia": "x² − 3x − 4 = 0: Δ = 9 + 16 = 25, x = (3 ± 5)/2, isto é, 4 e −1."
   }
  ],
  "quadro": [
   {
    "linha": "(x − 1)/2 = 3/(x − 2)",
    "nota": "proporção"
   },
   {
    "linha": "(x − 1)(x − 2) = 2 · 3",
    "nota": "multiplica em cruz"
   },
   {
    "linha": "x² − 3x + 2 = 6",
    "nota": "desenvolve"
   },
   {
    "linha": "x² − 3x − 4 = 0",
    "nota": "o 6 passa subtraindo"
   }
  ],
  "visual": null,
  "fontes": [],
  "aprovada": true,
  "revisao": {
   "lentes": [
    "resolvedor-autoconferencia",
    "conferente-fatos-e-didatica"
   ],
   "data": "2026-11-13",
   "lote": "mat-0051"
  }
 }
