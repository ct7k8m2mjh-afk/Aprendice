 "P261db2e5": {
  "n": "12",
  "conceito": "Inclusão e exclusão com dois conjuntos e o complemento.",
  "equivocos": {
   "A": "M01.5:sem-origem-identificada",
   "C": "M01.5:nao-descontou-a-intersecao",
   "D": "M01.5:somou-tudo"
  },
  "resolucao": {
   "antes": {
    "texto": "Quem acertou alguma atividade: acertou a 1.ª ou a 2.ª. Some as duas e tire quem foi contado duas vezes (acertou as duas). Depois some quem errou as duas.",
    "formulas": [
     "n(A ∪ B) = n(A) + n(B) − n(A ∩ B)"
    ],
    "simbolos": []
   },
   "pista": "Os 10 que acertaram as duas estão dentro dos 20 e também dentro dos 15.",
   "passos": [
    {
     "faz": "Acertaram alguma",
     "conta": "20 + 15 − 10 = 25",
     "porque": "Inclusão e exclusão.",
     "tipo": "calcular"
    },
    {
     "faz": "Turma",
     "conta": "25 + 15 = 40 → alternativa B",
     "porque": "Mais os que erraram as duas.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa B — 40",
   "checagem": "Separe em grupos sem repetição: só a 1.ª 20 − 10 = 10; só a 2.ª 15 − 10 = 5; as duas 10; nenhuma 15. Soma 10 + 5 + 10 + 15 = 40. Confere.",
   "erradas": {
    "A": "30 não confere: só a 1ª 10 + só a 2ª 5 + as duas 10 + nenhuma 15 = 40.",
    "C": "50 = 20 + 15 + 15: não descontou os 10 que acertaram as duas.",
    "D": "60 = 20 + 15 + 10 + 15: somou todos os números dados."
   },
   "armadilha": "Somar 20 + 15 sem tirar os 10 que estão nos dois grupos.",
   "alerta": "",
   "essencial": {
    "pede": "Total da turma.",
    "chave": "25 acertaram alguma, 15 nenhuma.",
    "cuidado": "Desconte a interseção."
   }
  },
  "caminhos": [
   {
    "nome": "diagrama",
    "ideia": "Dois círculos: 10 | 10 | 5, e fora 15. Total 40."
   }
  ],
  "quadro": [
   {
    "linha": "20 + 15 − 10 = 25",
    "nota": "acertaram alguma"
   },
   {
    "linha": "25 + 15 = 40",
    "nota": "resposta"
   }
  ],
  "visual": null,
