  "resolucao": {
   "antes": {
    "texto": "Um hectare é a área de um quadrado de 100 m por 100 m: 1 ha = 10 000 m² = 10^4 m². Um km² é um quadrado de 1 000 m por 1 000 m: 1 km² = 10^6 m².",
    "formulas": [
     "1 ha = 10^4 m²",
     "1 km² = 10^6 m²"
    ],
    "simbolos": []
   },
   "pista": "Quantos hectares cabem em 1 km²?",
   "passos": [
    {
     "faz": "Hectares em m²",
     "conta": "15 ha = 15 · 10^4 m²",
     "porque": "1 ha = 10^4 m².",
     "tipo": "calcular"
    },
    {
     "faz": "m² em km²",
     "conta": "15 · 10^4 ÷ 10^6 = 15 · 10^(−2) km²",
     "porque": "1 km² = 10^6 m².",
     "tipo": "calcular"
    },
    {
     "faz": "Escrever",
     "conta": "15 · 10^(−2) km² = 0,15 km² → alternativa B",
     "porque": "Forma da alternativa.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa B — 15x10-2, isto é, 15 × 10^(−2) km².",
   "checagem": "1 km² = 1 000 m × 1 000 m = (10 × 100 m) × (10 × 100 m) = 100 quadrados de 100 m × 100 m, ou seja, 100 ha. Então 15 ha = 15/100 km² = 0,15 km². Confere.",
   "erradas": {
