    "E": "10 × 10^3 não usa o 15 e vale 10 000 km²."
   },
   "armadilha": "Parar na conversão para m² (15 × 10^4) e não dividir por 10^6.",
   "alerta": "",
   "essencial": {
    "pede": "15 ha em km².",
    "chave": "1 km² = 100 ha.",
    "cuidado": "Área: o fator da unidade vai ao quadrado."
