    "B": "7 239 + 5 555 = 12 794 ≠ 12 905.",
    "D": "5 738,50 + 7 070,50 = 12 809 ≠ 12 905.",
    "E": "5 998 + 6 609 = 12 607 ≠ 12 905."
   },
   "armadilha": "Aplicar os 30% e 20% sobre o total gasto, misturando os dois produtos.",
   "alerta": "",
   "essencial": {
