  },
  "resolucao": {
   "antes": {
    "texto": "Sejam a e b os preços de custo de um produto A e de um B. Foram 9 de cada. O gasto total dá uma equação; o lucro (30% sobre o custo de A e 20% sobre o de B) dá outra.",
    "formulas": [
     "9a + 9b = 116 145",
     "0,30 · 9a + 0,20 · 9b = 29 444,40"
    ],
    "simbolos": [
     [
      "a, b",
      "preço de custo de cada produto"
     ]
    ]
   },
   "pista": "Divida as duas equações por 9 antes de resolver.",
   "passos": [
    {
     "faz": "Soma",
     "conta": "a + b = 12 905",
     "porque": "116 145 ÷ 9.",
     "tipo": "calcular"
    },
    {
     "faz": "Lucro",
     "conta": "0,3a + 0,2b = 3 271,60",
     "porque": "29 444,40 ÷ 9.",
     "tipo": "calcular"
    },
    {
     "faz": "Substituir",
     "conta": "0,3a + 0,2(12 905 − a) = 3 271,60 → 0,1a = 690,60",
     "porque": "b = 12 905 − a.",
     "tipo": "calcular"
    },
    {
     "faz": "Resolver",
     "conta": "a = 6 906; b = 5 999 → alternativa C",
     "porque": "Preços de custo.",
     "tipo": "concluir"
    }
