 "Pbeff836d": {
  "n": "41",
  "conceito": "Sistema linear de três quantidades com 'dobro do total' e 'metade mais 3'.",
  "equivocos": {
   "A": "M04.3:respondeu-outra-soma",
   "B": "M04.3:valor-que-nao-fecha",
