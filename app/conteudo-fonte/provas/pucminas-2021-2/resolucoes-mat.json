  },
  "resolucao": {
   "antes": {
    "texto": "B é o dobro de A + C. Então o total 108 é A + C mais o dobro disso: 3 vezes A + C. Daí sai A + C, depois B e, com a relação de C, cada farmácia.",
    "formulas": [
     "B = 2(A + C)",
     "C = A/2 + 3"
    ],
    "simbolos": [
     [
      "A, B, C",
      "encomendas de cada farmácia"
     ]
    ]
   },
   "pista": "Troque B por 2(A + C) na soma total.",
   "passos": [
    {
     "faz": "Ache A + C e B",
     "conta": "(A + C) + 2(A + C) = 108 → A + C = 36 → B = 72",
     "porque": "B é o dobro das outras duas juntas.",
     "tipo": "calcular"
    },
    {
     "faz": "Use a relação de C",
     "conta": "A + A/2 + 3 = 36 → 3A/2 = 33 → A = 22",
     "porque": "C é a metade de A mais 3.",
     "tipo": "calcular"
    },
    {
     "faz": "Ache C",
     "conta": "C = 22/2 + 3 = 14",
     "porque": "Ou C = 36 − 22.",
     "tipo": "calcular"
    },
    {
     "faz": "Responda",
     "conta": "B + C = 72 + 14 = 86 → alternativa C",
     "porque": "A pergunta é B mais C.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa C — 86",
   "checagem": "22 + 72 + 14 = 108; 72 = 2 · (22 + 14); 14 = 11 + 3. Tudo confere.",
   "erradas": {
    "A": "36 sai de A + C, o total das duas outras farmácias, não de B + C.",
    "B": "54 não confere: B sozinha já tem 72 encomendas.",
    "D": "94 sai de B + A = 72 + 22, a farmácia errada."
   },
   "armadilha": "Somar a farmácia errada: a pergunta é B + C, não B + A.",
   "alerta": "",
   "essencial": {
    "pede": "Quantas encomendas foram para B e C juntas.",
    "chave": "3(A + C) = 108: A + C = 36, B = 72; A = 22, C = 14.",
    "cuidado": "Some exatamente as farmácias pedidas."
   }
  },
  "caminhos": [
   {
    "nome": "atalho",
    "ideia": "B + C = 108 − A; com A = 22, B + C = 86."
