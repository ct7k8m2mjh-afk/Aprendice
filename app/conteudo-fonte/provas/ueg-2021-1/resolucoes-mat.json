 "P8225adef": {
  "n": "19",
  "conceito": "Conversão de polegadas para centímetros e comprimento da circunferência.",
  "equivocos": {
   "A": "M02.2:sem-origem-identificada",
   "B": "M02.2:sem-origem-identificada",
   "C": "M02.2:sem-origem-identificada",
   "D": "M02.2:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "O aro é o diâmetro em polegadas. Converta para centímetros (1 pol = 2,54 cm) e use C = π · d.",
    "formulas": [
     "C = π · d",
     "1 pol = 2,54 cm"
    ],
    "simbolos": []
   },
   "pista": "Qual é o diâmetro em centímetros?",
   "passos": [
    {
     "faz": "Diâmetro",
     "conta": "14 · 2,54 = 35,56 cm",
     "porque": "Aro 14.",
     "tipo": "calcular"
    },
    {
     "faz": "Circunferência",
     "conta": "C = π · 35,56 = 35,56π cm → alternativa E",
     "porque": "Fórmula com o diâmetro.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa E — 35,56π cm",
   "checagem": "Pelo raio: r = 35,56/2 = 17,78 cm; C = 2πr = 2 · 17,78π = 35,56π. Confere.",
   "erradas": {
    "A": "31,76π corresponderia a um aro de 12,5 polegadas (31,76/2,54).",
    "B": "32,46π corresponderia a cerca de 12,78 polegadas, não 14.",
    "C": "33,62π corresponderia a cerca de 13,24 polegadas, não 14.",
    "D": "34,47π corresponderia a cerca de 13,57 polegadas, não 14."
   },
   "armadilha": "Usar 2πd (confundindo diâmetro com raio) e dobrar o resultado.",
   "alerta": "",
   "essencial": {
    "pede": "Circunferência interna.",
    "chave": "d = 35,56 cm; C = 35,56π.",
    "cuidado": "Aro = diâmetro."
   }
  },
  "caminhos": [
   {
    "nome": "converter no fim",
    "ideia": "C = π · 14 pol = 14π pol; em centímetros, 14π · 2,54 = 35,56π cm."
   }
  ],
  "quadro": [
   {
    "linha": "14 · 2,54 = 35,56",
    "nota": "diâmetro em cm"
   },
   {
    "linha": "C = 35,56π",
    "nota": "resposta"
   }
  ],
  "visual": null,
