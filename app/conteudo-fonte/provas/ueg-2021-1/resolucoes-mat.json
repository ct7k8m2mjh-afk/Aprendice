 "P48dc7d0b": {
  "n": "22",
  "conceito": "Sistema de animais e patas.",
  "equivocos": {
   "B": "M04.3:valor-que-nao-fecha",
   "C": "M04.3:respondeu-outra-incognita",
   "D": "M04.3:valor-que-nao-fecha",
   "E": "M04.3:valor-que-nao-fecha"
  },
  "resolucao": {
   "antes": {
    "texto": "Porco tem 4 patas e galinha, 2. Com o total de animais e o total de patas saem duas equações.",
    "formulas": [
     "p + y = 16",
     "4p + 2y = 46"
    ],
    "simbolos": [
     [
      "p",
      "porcos"
     ],
     [
      "y",
      "galinhas"
     ]
    ]
   },
   "pista": "Se todos fossem galinhas, quantas patas haveria?",
   "passos": [
    {
     "faz": "Monte o sistema",
     "conta": "p + y = 16 | 4p + 2y = 46",
     "porque": "Animais e patas.",
     "tipo": "calcular"
    },
    {
     "faz": "Elimine y",
     "conta": "4p + 2y − 2(p + y) = 46 − 32 → 2p = 14",
     "porque": "Subtraia o dobro da primeira equação.",
     "tipo": "calcular"
    },
    {
     "faz": "Resolva",
     "conta": "p = 14/2 = 7",
     "porque": "Cada porco tem 2 patas a mais que uma galinha.",
     "tipo": "calcular"
    },
    {
     "faz": "Responda",
     "conta": "7 porcos → alternativa A",
     "porque": "A pergunta é o número de porcos.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa A — 7",
   "checagem": "7 porcos e 9 galinhas: 28 + 18 = 46 patas e 16 animais.",
   "erradas": {
    "B": "8 não confere: 8 porcos e 8 galinhas dão 32 + 16 = 48 patas.",
    "C": "9 é o número de galinhas (16 − 7), não de porcos.",
    "D": "10 não confere: 40 + 12 = 52 patas.",
    "E": "12 não confere: 48 + 8 = 56 patas."
   },
   "armadilha": "Achar as galinhas (9) e marcar como porcos.",
   "alerta": "",
   "essencial": {
    "pede": "O número de porcos.",
    "chave": "2p = 46 − 2 · 16 = 14, p = 7.",
    "cuidado": "Responda a variável pedida."
   }
  },
  "caminhos": [
   {
    "nome": "todos galinhas",
    "ideia": "16 galinhas teriam 32 patas; faltam 14, e cada porco acrescenta 2: 7 porcos."
   }
  ],
  "quadro": [
   {
    "linha": "4p + 2y − 2 · (p + y) = 46 − 2 · 16",
    "nota": "tira o dobro dos animais"
   },
   {
    "linha": "2p = 46 − 32 = 14",
    "nota": "y se cancela"
   },
   {
    "linha": "p = 14/2 = 7",
    "nota": "o 2 passa dividindo"
   }
  ],
  "visual": null,
  "fontes": [],
