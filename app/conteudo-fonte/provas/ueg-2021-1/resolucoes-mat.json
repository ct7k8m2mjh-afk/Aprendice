{
 "P52bfa35b": {
  "n": "21",
  "conceito": "Frações compostas com expoente zero.",
  "equivocos": {
   "A": "M01.2:potencia-zero-como-zero",
   "B": "M01.2:sem-origem-identificada",
   "D": "M01.2:potencia-zero-como-zero",
   "E": "M01.2:sem-origem-identificada"
  },
  "resolucao": {
   "antes": {
    "texto": "Todo número não nulo elevado a 0 vale 1: 1000^0 = 1 e (3/2)^0 = 1. Substitua isso primeiro e simplifique as frações de dentro para fora. O sinal \":\" é divisão.",
    "formulas": [
     "a^0 = 1"
    ],
    "simbolos": []
   },
   "pista": "Troque cada 1000^0 por 1 e resolva a fração mais de baixo primeiro.",
   "passos": [
    {
     "faz": "Numerador",
     "conta": "1 + 1/(1 + 1) = 1 + 1/2 = 3/2",
     "porque": "1000^0 = 1.",
     "tipo": "calcular"
    },
    {
     "faz": "Denominador",
     "conta": "1 + 1/(1 + 1/2) = 1 + 2/3 = 5/3",
     "porque": "De dentro para fora.",
     "tipo": "calcular"
    },
    {
     "faz": "Fração",
     "conta": "(3/2) ÷ (5/3) = 9/10",
     "porque": "Inverso do divisor.",
     "tipo": "calcular"
    },
    {
     "faz": "Colchete",
     "conta": "2 + 1 + 3/2 = 9/2",
     "porque": "(3/2)^0 = 1.",
     "tipo": "calcular"
    },
    {
     "faz": "Divisão final",
     "conta": "(9/10) ÷ (9/2) = (9/10) · (2/9) = 2/10 = 1/5 → alternativa C",
     "porque": "Resultado.",
     "tipo": "concluir"
    }
   ],
   "resposta": "Alternativa C — 1/5",
   "checagem": "Em decimal: numerador 1,5; denominador 1,666...; fração 0,9; colchete 4,5; 0,9 ÷ 4,5 = 0,2 = 1/5. Confere.",
   "erradas": {
    "A": "2/21 sai fazendo 1000^0 = 0 e (3/2)^0 = 0: a fração vira 1/3 e o colchete 7/2.",
    "B": "1/7 exigiria a fração valer 9/14 com colchete 9/2; ela vale 9/10.",
    "D": "2/27 sai fazendo 1000^0 = 0: a fração vira 1/3, e (1/3) ÷ (9/2) = 2/27.",
    "E": "1/14 exigiria a fração valer 9/28; ela vale 9/10."
   },
   "armadilha": "Achar que 1000^0 = 0; qualquer número não nulo elevado a zero dá 1.",
   "alerta": "",
   "essencial": {
    "pede": "Valor da expressão.",
    "chave": "1000^0 = (3/2)^0 = 1.",
    "cuidado": "Resolva frações compostas de baixo para cima."
   }
  },
  "caminhos": [
   {
    "nome": "multiplicar por 6",
    "ideia": "Simplifique a fração composta multiplicando em cima e embaixo por 6: (1 + 1/2)/(1 + 2/3) = (6 + 3)/(6 + 4) = 9/10; depois 9/10 ÷ 9/2 = 1/5."
   }
  ],
  "quadro": [
   {
    "linha": "1 + 1/(1 + 1) = 1 + 1/2 = 3/2",
    "nota": "Numerador"
   },
   {
    "linha": "1 + 1/(1 + 1/2) = 1 + 2/3 = 5/3",
    "nota": "Denominador"
   },
   {
    "linha": "(3/2) ÷ (5/3) = 9/10",
    "nota": "Fração"
   },
   {
    "linha": "2 + 1 + 3/2 = 9/2",
    "nota": "Colchete"
   },
   {
    "linha": "(9/10) ÷ (9/2) = (9/10) · (2/9) = 2/10 = 1/5",
    "nota": "Divisão final"
   }
  ],
  "visual": null,
  "fontes": [],
  "aprovada": true,
  "revisao": {
   "lentes": [
    "resolvedor-autoconferencia",
    "conferente-fatos-e-didatica"
   ],
   "data": "2026-11-12",
   "lote": "mat-0043"
  }
