  ],
  "erro_comum": "Tratar 'might' e 'must' como equivalentes.",
  "peso": 2,
  "exemplo": "'He must be at home' (quase certo) x 'He might be at home' (talvez).",
  "exemplo_autoral": true,
  "fonte": "Swan, Michael. Practical English Usage, 4th ed. Oxford University Press, 2016.",
  "amostra": true
 },
 {
