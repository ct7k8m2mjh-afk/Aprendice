  "sub": "I03.2",
  "tipo": "identificar",
  "frente": "Que relação 'therefore' estabelece?",
  "verso": "Conclusão ou consequência: portanto.",
  "essencial": [
   "conclusão",
   "consequência"
  ],
  "aceita": [
   "portanto",
   "por isso",
   "resultado"
  ],
  "erro_comum": "Confundir com contraste ('however').",
  "peso": 3,
  "exemplo": "'It rained; therefore, we stayed home.'",
  "exemplo_autoral": true,
  "fonte": "Cambridge Dictionary, verbete 'therefore' — https://dictionary.cambridge.org/dictionary/english/therefore",
  "amostra": false
 },
 {
