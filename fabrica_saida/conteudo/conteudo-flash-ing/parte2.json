  "fonte": "Cambridge Dictionary, verbete 'despite' — https://dictionary.cambridge.org/dictionary/english/despite",
  "amostra": false
 },
 {
  "id": "ing-d059",
  "mod": "I03",
  "sub": "I03.1",
  "tipo": "processo",
  "frente": "Como achar o referente de 'it' ou 'they' no texto?",
  "verso": "Voltar à frase anterior e achar o substantivo que concorda em número com o pronome.",
  "essencial": [
   "frase anterior",
   "substantivo",
   "número"
  ],
  "aceita": [
   "concordância",
   "antecedente"
  ],
  "erro_comum": "Escolher o substantivo mais próximo sem checar singular ou plural.",
  "peso": 3,
  "exemplo": "'The books arrived. They were new.' 'They' retoma 'the books' (plural).",
  "exemplo_autoral": true,
  "fonte": "Swan, Michael. Practical English Usage, 4th ed. Oxford University Press, 2016.",
  "amostra": true
 },
 {
  "id": "ing-d060",
  "mod": "I03",
  "sub": "I03.1",
  "tipo": "identificar",
  "frente": "Em 'He lost, which surprised everyone', a que 'which' se refere?",
  "verso": "Ao fato inteiro de ele ter perdido, não a um substantivo.",
  "essencial": [
   "fato de ele ter perdido"
  ],
  "aceita": [
   "he lost",
   "ao fato de perder"
  ],
  "erro_comum": "Ligar 'which' só à palavra 'lost'.",
  "peso": 2,
  "exemplo": "'She won, which made us happy.' 'Which' = o fato de ela ter vencido.",
  "exemplo_autoral": true,
  "fonte": "Murphy, Raymond. English Grammar in Use, 5th ed. Cambridge University Press, 2019.",
  "amostra": false
 },
 {
  "id": "ing-d061",
  "mod": "I03",
  "sub": "I03.8",
  "tipo": "identificar",
  "frente": "O que o '-ly' faz em 'quickly' e o que essa palavra modifica?",
  "verso": "Transforma o adjetivo 'quick' em advérbio, que modifica o verbo: 'runs quickly'.",
