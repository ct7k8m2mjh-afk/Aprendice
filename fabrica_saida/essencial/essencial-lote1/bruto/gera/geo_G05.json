   "text": "```json\n{\n  \"essencial\": {\n    \"termometro\": [\n      {\"sub\": \"G05.1\", \"peso\": \"alta\", \"provas\": \"Unicamp, Fuvest, UEL, Unesp, EsPCEx, Famerp, PUC-Rio\", \"como_cai\": \"O texto descreve a paisagem e a questão pede o bioma; também caem Cerrado × Caatinga e igapó × terra firme.\"},\n      {\"sub\": \"G05.4\", \"peso\": \"alta\", \"provas\": \"Unicamp, ESPM, UEA, UFRGS, UEL, Enem\", \"como_cai\": \"Gráfico do Prodes ou do MapBiomas: leia fonte, período e unidade antes de comparar.\"},\n      {\"sub\": \"G05.2\", \"peso\": \"media\", \"provas\": \"Fuvest, EsPCEx, Famerp\", \"como_cai\": \"Foto ou climograma pede o domínio de Ab'Sáber; faixa de transição e ecótono aparecem nos enunciados.\"},\n      {\"sub\": \"G05.3\", \"peso\": \"media\", \"provas\": \"UEPG, Unicamp, UFRGS, EsPCEx\", \"como_cai\": \"Mapa ou climograma pede a formação vegetal; também caem adaptações da planta e desertificação.\"}\n    ],\n    \"mapa\": {\n      \"centro\": \"Biomas e vegetação\",\n      \"ramos\": [\n        {\"sub\": \"G05.1\", \"titulo\": \"Biomas brasileiros\", \"chave\": \"Seis biomas do IBGE; pistas de folha, solo e água\", \"liga\": [\"G05.2\", \"G05.4\"]},\n        {\"sub\": \"G05.4\", \"titulo\": \"Desmatamento\", \"chave\": \"Corte, queima, pasto, soja; Prodes de agosto a julho\", \"liga\": [\"G05.1\"]},\n        {\"sub\": \"G05.2\", \"titulo\": \"Domínios de Ab'Sáber\", \"chave\": \"Domínio = relevo, clima, solo, rios e vegetação\", \"liga\": [\"G05.1\"]},\n        {\"sub\": \"G05.3\", \"titulo\": \"Vegetação do mundo\", \"chave\": \"Vegetação acompanha clima e altitude, do equador aos polos\", \"liga\": [\"G05.1\"]}\n      ]\n    },\n    \"telas\": [\n      {\n        \"sub\": \"G05.1\",\n        \"titulo\": \"Os seis biomas do IBGE\",\n        \"pontos\": [\n          \"IBGE: Amazônia 49,5%, Cerrado 23,3%, Mata Atlântica 13%.\",\n          \"Caatinga 10,1%, Pampa 2,3%, Pantanal 1,8% (2019).\",\n          \"Pistas: espinhos (Caatinga), caule retorcido (Cerrado), planície inundável (Pantanal), coxilhas (Pampa).\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{IBGE: Amazônia, Cerrado, Mata Atlântica,} \\\\\\\\ \\\\text{Caatinga, Pampa e Pantanal} \\\\end{gathered}\",\n        \"pegadinha\": \"Mangue, restinga, Mata dos Cocais e Araucárias não são biomas do IBGE.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Mapa do Brasil com barra empilhada de 100% ao lado.\", \"movimento\": [\"Cada bioma se pinta com sua porcentagem, da Amazônia ao Pantanal.\", \"Os intrusos (mangue, restinga, Cocais, Araucárias) são recusados.\"]}\n      },\n      {\n        \"sub\": \"G05.1\",\n        \"titulo\": \"Cerrado × Caatinga\",\n        \"pontos\": [\n          \"Cerrado: caule retorcido e casca grossa pelo solo ácido e pobre.\",\n          \"A maioria das árvores do Cerrado mantém as folhas na seca.\",\n          \"Caatinga: xeromorfismo pela seca; espinhos e queda de folhas.\",\n          \"Buriti marca a vereda, com água, no Cerrado.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{Cerrado: xeromorfismo pelo solo ácido;} \\\\\\\\ \\\\text{a maioria mantém as folhas} \\\\\\\\ \\\\text{Caatinga: xeromorfismo pela seca;} \\\\\\\\ \\\\text{muitas plantas perdem as folhas} \\\\end{gathered}\",\n        \"pegadinha\": \"Não explique o caule torto do Cerrado pela falta de chuva.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Duas árvores retorcidas lado a lado, com calendário de chuva e seca.\", \"movimento\": [\"Na seca, a do Cerrado segue com folhas; a da Caatinga fica cinza e sem folhas.\", \"Abaixo de cada uma, a causa: solo ácido ou clima semiárido.\"]}\n      },\n      {\n        \"sub\": \"G05.1\",\n        \"titulo\": \"Amazônia, Mata Atlântica e Pampa\",\n        \"pontos\": [\n          \"Amazônia: igapó sempre alagado, várzea às vezes, terra firme nunca.\",\n          \"Mata Atlântica: restam 12,4% ou cerca de 25%, conforme o método.\",\n          \"Pampa: arenização no sudoeste do RS.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{igapó: sempre alagado; várzea: às vezes;} \\\\\\\\ \\\\text{terra firme: nunca} \\\\end{gathered}\",\n        \"pegadinha\": \"Amazônia Legal (cerca de 59% do país) não é o bioma Amazônia (49,5%).\",\n        \"visual\": {\"tipo\": \"esquema\", \"descricao\": \"Perfil do vale amazônico com igapó, várzea e terra firme nas margens do rio.\", \"movimento\": [\"O rio sobe e desce: o igapó fica sempre debaixo d'água, a várzea aparece e some, a terra firme nunca molha.\"]}\n      },\n      {\n        \"sub\": \"G05.4\",\n        \"titulo\": \"Como a vegetação nativa cai\",\n        \"pontos\": [\n          \"Sequência típica: corte, queima, pasto, soja.\",\n          \"Arco do desmatamento: sul e leste (PA, MT, RO, AC).\",\n          \"Cerrado: cerca de metade nativa; fronteira agrícola no MATOPIBA.\",\n          \"Mata Atlântica: primeira devastada (pau-brasil, cana, café, cidades).\"\n        ],\n        \"pegadinha\": \"Taxa menor não significa bioma preservado.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Mapa da Amazônia Legal com ícones de motosserra, fogo, gado e soja.\", \"movimento\": [\"Uma estrada abre clareiras e os ícones acendem em sequência.\", \"Uma faixa cresce do sul e do leste: arco do desmatamento.\"]}\n      },\n      {\n        \"sub\": \"G05.4\",\n        \"titulo\": \"Lendo gráficos de desmatamento\",\n        \"pontos\": [\n          \"Prodes (Inpe): agosto a julho. SAD (Imazon): janeiro a dezembro.\",\n          \"Prodes Amazônia: 13 mil km² em 2021; 3 335 km² em 2026, menor da série.\",\n          \"Por isso fontes diferentes apontam anos-recorde diferentes.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{Prodes (Inpe): agosto a julho} \\\\\\\\ \\\\text{SAD (Imazon): janeiro a dezembro} \\\\end{gathered}\",\n        \"pegadinha\": \"Pulmão do mundo é mito: vale pelo carbono, pela chuva e pelas espécies.\",\n        \"visual\": {\"tipo\": \"grafico\", \"descricao\": \"Duas réguas de tempo desencontradas, Prodes e SAD.\", \"movimento\": [\"Os blocos de agosto a julho e de janeiro a dezembro não coincidem: o mesmo desmatamento cai em anos diferentes.\"]}\n      },\n      {\n        \"sub\": \"G05.2\",\n        \"titulo\": \"Domínios de Ab'Sáber\",\n        \"pontos\": [\n          \"Seis domínios: Amazônico, Cerrado, Mares de Morros, Caatingas, Araucárias, Pradarias.\",\n          \"Mata dos Cocais (MA e PI) é ecótono, faixa de transição.\",\n          \"Reduto: mancha de vegetação herdada de clima antigo.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{Ab'Sáber: domínio =} \\\\\\\\ \\\\text{relevo + clima + solo + rios + vegetação} \\\\end{gathered}\",\n        \"pegadinha\": \"Araucárias e Pradarias são domínios, não biomas do IBGE.\",\n        \"visual\": {\"tipo\": \"esquema\", \"descricao\": \"Cinco camadas (relevo, clima, solo, rios, vegetação) sobre o mapa.\", \"movimento\": [\"Onde todas combinam, surge o núcleo do domínio; nas bordas, a faixa de transição.\"]}\n      },\n      {\n        \"sub\": \"G05.3\",\n        \"titulo\": \"Vegetação do mundo\",\n        \"pontos\": [\n          \"Do equador aos polos: floresta equatorial, savana, deserto, temperada, taiga, tundra.\",\n          \"Aciculifoliada: agulha; latifoliada: folha larga; caducifólia: perde folhas.\",\n          \"Mediterrânea: verão seco, inverno chuvoso, arbustos duros; uva e oliveira.\"\n        ],\n        \"pegadinha\": \"Perder folhas: frio na temperada, seca na Caatinga.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Planisfério de climas com a vegetação sobreposta.\", \"movimento\": [\"As faixas de vegetação cobrem as de clima: as manchas coincidem, do equador à tundra.\"]}\n      },\n      {\n        \"sub\": \"G05.3\",\n        \"titulo\": \"Floresta equatorial e montanha\",\n        \"pontos\": [\n          \"Floresta equatorial: maior biodiversidade sobre solo pobre; nutrientes circulam rápido nas plantas.\",\n          \"Desmatada, a chuva lava os nutrientes do solo (lixiviação).\",\n          \"Montanha tropical: floresta, mata de neblina, campos de altitude, neve.\"\n        ],\n        \"pegadinha\": \"Floresta exuberante não significa solo fértil.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Colunas de solo com bolinhas de nutrientes.\", \"movimento\": [\"Ao desmatar a equatorial, a chuva lava as bolinhas e o solo fica vazio.\"]}\n      }\n    ],\n    \"questao_resolvida\": {\n      \"enunciado\": \"Sobre a Amazônia, considere as afirmações. I. O igapó fica alagado o ano todo, a várzea só nas cheias e a terra firme nunca alaga. II. O solo da floresta é fértil; por isso, desmatada, a área vira ótima lavoura permanente. III. A Amazônia Legal tem a mesma área do bioma Amazônia. IV. A floresta é o 'pulmão do mundo', pois produz muito mais oxigênio do que consome. Está correto o que se afirma em:\",\n      \"alternativas\": [\n        \"A) I apenas.\",\n        \"B) I e IV.\",\n        \"C) II e III.\",\n        \"D) III e IV.\",\n        \"E) I, II e IV.\"\n      ],\n      \"gabarito\": \"A\",\n      \"passos\": [\n        {\"faz\": \"Avaliar I: igapó, várzea e terra firme\", \"conta\": \"\\\\text{sempre} / \\\\text{às vezes} / \\\\text{nunca} \\\\rightarrow \\\\text{verdadeira}\", \"mov\": \"As três faixas do vale acendem na ordem certa.\"},\n        {\"faz\": \"Avaliar II: o solo\", \"conta\": \"\\\\text{solo pobre; chuva lava nutrientes} \\\\rightarrow \\\\text{falsa}\", \"mov\": \"Os nutrientes nas plantas somem quando as árvores caem.\"},\n        {\"faz\": \"Avaliar III: a área\", \"conta\": \"\\\\text{Legal} \\\\approx 59\\\\% \\\\neq 49{,}5\\\\% \\\\rightarrow \\\\text{falsa}\", \"mov\": \"Dois contornos de tamanhos diferentes se sobrepõem.\"},\n        {\"faz\": \"Avaliar IV: oxigênio\", \"conta\": \"\\\\text{consome quase todo o O}_2 \\\\rightarrow \\\\text{falsa}\", \"mov\": \"O rótulo 'pulmão do mundo' é riscado.\"},\n        {\"faz\": \"Concluir\", \"conta\": \"\\\\text{só I} \\\\rightarrow \\\\text{A}\", \"mov\": \"A alternativa A ganha moldura.\"}\n      ],\n      \"por_que_erram\": \"Muitos marcam a IV (alternativas B e E) por repetir o mito do 'pulmão do mundo': a floresta consome quase todo o oxigênio que produz.\"\n    },\n    \"conexao\": [\n      {\"materia\": \"Biologia\", \"frase\": \"Folha em agulha, espinho, caducifólia e xeromorfismo são adaptações que a Biologia explica; a respiração da floresta desfaz o mito do pulmão.\"},\n      {\"materia\": \"História\", \"frase\": \"Pau-brasil, cana e café foram os ciclos econômicos que derrubaram a Mata Atlântica.\"},\n      {\"materia\": \"Matemática\", \"frase\": \"Gráficos do Prodes pedem diferença e porcentagem: queda de 7 235 para 5 517 km² é cerca de 24%.\"}\n    ]\n  },\n  \"pendencias\": [\n    \"O peso (alta, média, baixa) foi inferido da lista de bancas e do tipo de cobrança nos slides 'Como cai na prova'; os slides não trazem o rótulo de peso.\",\n    \"Ficaram fora das telas, por peso baixo e limite de 12 telas: desertificação × arenização (só na fórmula do tema), refúgios de Haffer em detalhe, tundra e taiga, estepe e pradaria, e a lista de plantas (xerófila, higrófila, tropófila, halófita).\",\n    \"O material não traz as taxas do Prodes de 2022 e 2023; o gráfico usa só os anos que constam dos slides.\"\n  ]\n}\n```",
