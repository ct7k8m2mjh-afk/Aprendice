   "text": "```json\n{\n  \"essencial\": {\n    \"termometro\": [\n      {\n        \"sub\": \"I02.2\",\n        \"peso\": \"alta\",\n        \"provas\": \"PUC-Rio, UFSC, UENP, IFS, Unifesp, FMABC, Uerj\",\n        \"como_cai\": \"A alternativa com a tradução parecida com o português (actually = atualmente) entra como isca ao lado do sentido certo.\"\n      },\n      {\n        \"sub\": \"I02.1\",\n        \"peso\": \"alta\",\n        \"provas\": \"Fuvest, Unifesp, UFRGS, PUC-Rio, ESPM, UFSC\",\n        \"como_cai\": \"'A expressão pode ser substituída por': vale o sinônimo que cabe naquela frase, não qualquer sentido do dicionário.\"\n      },\n      {\n        \"sub\": \"I02.3\",\n        \"peso\": \"alta\",\n        \"provas\": \"Fuvest, UFPR, UnB, UFRGS, ESPM, UFMS, IFS\",\n        \"como_cai\": \"Pede-se trocar o phrasal verb por um verbo de uma palavra (passed out = fainted); a isca é traduzir só o verbo.\"\n      },\n      {\n        \"sub\": \"I02.4\",\n        \"peso\": \"media\",\n        \"provas\": \"Unesp, EsPCEx, UENP, UFRGS, Mackenzie, UEM, UEL, Enem\",\n        \"como_cai\": \"A prova pede o sentido da expressão no contexto ou o equivalente em português; a tradução literal é a isca.\"\n      },\n      {\n        \"sub\": \"I02.5\",\n        \"peso\": \"baixa\",\n        \"provas\": \"EsPCEx, Unesp, UFSC, UEM, Enem\",\n        \"como_cai\": \"Pede o sentido montado pelas peças (unmistakable) ou a classe da palavra pela terminação.\"\n      }\n    ],\n    \"mapa\": {\n      \"centro\": \"Vocabulário\",\n      \"ramos\": [\n        {\n          \"sub\": \"I02.2\",\n          \"titulo\": \"Falsos cognatos\",\n          \"chave\": \"parece português, mas não é: actually = na verdade\",\n          \"liga\": [\"I02.1\"]\n        },\n        {\n          \"sub\": \"I02.1\",\n          \"titulo\": \"Sentido no contexto\",\n          \"chave\": \"a frase em volta define a palavra: explicação, exemplo, contraste\",\n          \"liga\": [\"I02.2\", \"I02.3\"]\n        },\n        {\n          \"sub\": \"I02.3\",\n          \"titulo\": \"Phrasal verbs\",\n          \"chave\": \"verbo + partícula: o sentido é do conjunto\",\n          \"liga\": [\"I02.4\"]\n        },\n        {\n          \"sub\": \"I02.4\",\n          \"titulo\": \"Expressões idiomáticas\",\n          \"chave\": \"sentido do conjunto; tradução palavra por palavra é a isca\",\n          \"liga\": [\"I02.3\"]\n        },\n        {\n          \"sub\": \"I02.5\",\n          \"titulo\": \"Prefixos e sufixos\",\n          \"chave\": \"prefixo muda o sentido; sufixo pode mudar a classe\",\n          \"liga\": [\"I02.1\"]\n        }\n      ]\n    },\n    \"telas\": [\n      {\n        \"sub\": \"I02.2\",\n        \"titulo\": \"Falsos cognatos\",\n        \"pontos\": [\n          \"Parece português, mas significa outra coisa: é a isca da alternativa.\",\n          \"Também: attend = frequentar; parents = pais; college = faculdade; prejudice = preconceito; injured = ferido.\"\n        ],\n        \"formula\": \"\\\\begin{gathered}\\\\text{actually = na verdade}\\\\\\\\ \\\\text{currently = atualmente}\\\\\\\\ \\\\text{eventually = por fim}\\\\\\\\ \\\\text{pretend = fingir; intend = pretender}\\\\end{gathered}\",\n        \"pegadinha\": \"Se a tradução fácil não fecha no contexto, é a isca.\"\n      },\n      {\n        \"sub\": \"I02.1\",\n        \"titulo\": \"Sentido da palavra no contexto\",\n        \"pontos\": [\n          \"A palavra ganha sentido na frase; leia tudo antes de traduzir.\",\n          \"Pistas: that is, such as, contraste (but, instead) e cognato verdadeiro.\",\n          \"work out = malhar, entender, dar certo.\"\n        ],\n        \"pegadinha\": \"Teste na frase: rather em rather loveable é bastante.\"\n      },\n      {\n        \"sub\": \"I02.3\",\n        \"titulo\": \"Phrasal verbs\",\n        \"pontos\": [\n          \"Verbo + partícula: o sentido é do conjunto, não de cada peça.\",\n          \"give up = desistir; find out = descobrir; rule out = descartar; pass out = desmaiar.\"\n        ],\n        \"formula\": \"\\\\begin{gathered}\\\\text{verbo} + \\\\text{pronome} + \\\\text{partícula}\\\\\\\\ \\\\text{turn it down, nunca turn down it}\\\\end{gathered}\",\n        \"pegadinha\": \"Traduzir só o verbo (give = dar) leva à alternativa errada.\"\n      },\n      {\n        \"sub\": \"I02.4\",\n        \"titulo\": \"Expressões idiomáticas\",\n        \"pontos\": [\n          \"Idiom tem sentido do conjunto: piece of cake = molezinha.\",\n          \"from scratch = do zero; learn by heart = decorar; at last = finalmente.\"\n        ],\n        \"pegadinha\": \"Palavra por palavra é a isca: laugh your head off = morrer de rir.\"\n      },\n      {\n        \"sub\": \"I02.5\",\n        \"titulo\": \"Prefixos e sufixos\",\n        \"pontos\": [\n          \"Prefixo muda o sentido; sufixo muda a classe: un- + mistake + -able = inconfundível.\",\n          \"Sufixos de adjetivo: -able, -ful, -less; de substantivo: -ness, -ity, -ion.\"\n        ],\n        \"pegadinha\": \"-ly nem sempre é advérbio: friendly é adjetivo.\"\n      }\n    ],\n    \"questao_resolvida\": {\n      \"enunciado\": \"Leia o texto: 'Carlos finished school last year. Currently, he works at a bookstore. Actually, he intends to open his own shop next year.' As palavras actually e intends significam, respectivamente:\",\n      \"alternativas\": [\n        \"A) atualmente; pretende\",\n        \"B) na verdade; finge\",\n        \"C) na verdade; pretende\",\n        \"D) atualmente; finge\",\n        \"E) eventualmente; pretende\"\n      ],\n      \"gabarito\": \"C\",\n      \"passos\": [\n        {\n          \"faz\": \"Ler o texto inteiro e marcar as palavras suspeitas.\",\n          \"conta\": \"\\\\text{Currently} \\\\;\\\\ldots\\\\; \\\\text{Actually} \\\\;\\\\ldots\\\\; \\\\text{intends}\",\n          \"mov\": \"As três palavras piscam; cada uma mostra a tradução parecida com o português.\"\n        },\n        {\n          \"faz\": \"Notar que currently já aparece e traduzir.\",\n          \"conta\": \"\\\\text{currently} = \\\\text{atualmente}\",\n          \"mov\": \"'Currently' ganha 'atualmente' (ele trabalha numa livraria agora).\"\n        },\n        {\n          \"faz\": \"Ver que actually abre uma ideia nova: não repete currently.\",\n          \"conta\": \"\\\\text{actually} = \\\\text{na verdade}\",\n          \"mov\": \"A, D e E, que dão 'atualmente' ou 'eventualmente', são riscadas.\"\n        },\n        {\n          \"faz\": \"Traduzir intends pelo contexto.\",\n          \"conta\": \"\\\\text{next year} \\\\Rightarrow \\\\text{intend} = \\\\text{pretender}\",\n          \"mov\": \"'Next year' acende: é plano futuro, não fingimento. B é riscada.\"\n        },\n        {\n          \"faz\": \"Concluir.\",\n          \"conta\": \"\\\\text{(C) na verdade; pretende}\",\n          \"mov\": \"A alternativa C ganha a moldura.\"\n        }\n      ],\n      \"por_que_erram\": \"Quem marca A lê actually como atualmente, a tradução parecida, e não percebe que currently já foi usado antes com esse sentido.\"\n    }\n  },\n  \"pendencias\": [\n    \"Conexão com outras matérias não incluída: o material do tema não traz ligação com outra matéria e não entra fato novo.\",\n    \"Peso de I02.4 (média) e I02.5 (baixa) foi definido pela quantidade e pela variedade de provas citadas nos slides 'Como cai na prova'; o material não traz percentuais por tema.\",\n    \"Sem visual nas telas: o material tem animações nos slides, mas nenhuma é essencial para a revisão curta.\"\n  ]\n}\n```",
