   "text": "```json\n{\n  \"essencial\": {\n    \"termometro\": [\n      {\"sub\": \"L07.4\", \"peso\": \"alta\", \"provas\": \"Enem, Unesp, UEL, UFSC, UEM\", \"como_cai\": \"Trecho sobre técnica sem fins humanos, indústria cultural ou consenso: reconhecer razão instrumental, Adorno e Horkheimer ou Habermas.\"},\n      {\"sub\": \"L07.2\", \"peso\": \"media\", \"provas\": \"UFPR\", \"como_cai\": \"Discursiva: definir menoridade e esclarecimento e mostrar que pagar o imposto e criticá-lo em público não se contradizem.\"},\n      {\"sub\": \"L07.1\", \"peso\": \"media\", \"provas\": \"UEA\", \"como_cai\": \"Pano de fundo: razão contra a tradição, ligação com 1776 e 1789 e autonomia em Kant.\"},\n      {\"sub\": \"L07.3\", \"peso\": \"baixa\", \"provas\": \"Enem\", \"como_cai\": \"Trecho contra perseguição religiosa (tolerância) ou salões e cafés do século XVIII a partir de Habermas.\"}\n    ],\n    \"mapa\": {\n      \"centro\": \"Iluminismo\",\n      \"ramos\": [\n        {\"sub\": \"L07.1\", \"titulo\": \"Razão, progresso e autonomia\", \"chave\": \"razão como critério contra tradição, rei e Igreja\", \"liga\": [\"L07.2\", \"L07.3\"]},\n        {\"sub\": \"L07.2\", \"titulo\": \"Kant: esclarecimento\", \"chave\": \"sair da menoridade; uso público livre, uso privado no cargo\", \"liga\": [\"L07.1\", \"L07.4\"]},\n        {\"sub\": \"L07.3\", \"titulo\": \"Voltaire e tolerância\", \"chave\": \"o Estado não impõe crença; Enciclopédia reúne o saber\", \"liga\": [\"L07.1\"]},\n        {\"sub\": \"L07.4\", \"titulo\": \"Frankfurt e Habermas\", \"chave\": \"razão instrumental calcula meios; razão comunicativa busca consenso\", \"liga\": [\"L07.1\", \"L07.2\"]}\n      ]\n    },\n    \"telas\": [\n      {\n        \"sub\": \"L07.4\",\n        \"titulo\": \"Frankfurt: a razão virou instrumento\",\n        \"pontos\": [\n          \"Dialética do esclarecimento (1947): esclarecimento vira dominação.\",\n          \"Razão instrumental: calcula meios, não discute fins.\",\n          \"Indústria cultural: padroniza gostos; massas são produto.\",\n          \"Pistas: eficiência acima de tudo, técnica sem fins humanos.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{razão instrumental: calcula meios,} \\\\\\\\ \\\\text{não discute fins} \\\\end{gathered}\",\n        \"pegadinha\": \"Frankfurt critica a razão reduzida a cálculo, não a razão.\",\n        \"visual\": {\n          \"tipo\": \"animacao\",\n          \"descricao\": \"Máquina de calcular que recebe um fim vindo de fora e devolve o meio mais eficiente; o botão ‘este fim é justo?’ não existe.\",\n          \"movimento\": [\"Entra ‘construir uma ponte’ e sai um projeto.\", \"Entra ‘produzir uma bomba’ e sai outro projeto, com a mesma eficiência.\", \"O espaço do botão ‘fim justo?’ pisca vazio.\"]\n        }\n      },\n      {\n        \"sub\": \"L07.4\",\n        \"titulo\": \"Habermas: razão comunicativa\",\n        \"pontos\": [\n          \"Habermas (1981): razão comunicativa, consenso sem coerção, pelo melhor argumento.\",\n          \"Sistema (Estado, mercado): agir instrumental. Mundo da vida (família, comunidade): agir comunicativo.\",\n          \"Colonização: o sistema invade o mundo da vida.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{Habermas: razão comunicativa} \\\\\\\\ \\\\rightarrow \\\\text{consenso sem coerção} \\\\end{gathered}\",\n        \"pegadinha\": \"Habermas aceita a razão instrumental no seu lugar.\",\n        \"visual\": {\n          \"tipo\": \"animacao\",\n          \"descricao\": \"Engrenagens do sistema avançam sobre o mundo da vida; balões de conversa as empurram de volta.\",\n          \"movimento\": [\"As engrenagens cobrem parte do mundo da vida.\", \"Os balões formam uma roda de conversa e crescem.\", \"As engrenagens recuam até a fronteira.\"]\n        }\n      },\n      {\n        \"sub\": \"L07.2\",\n        \"titulo\": \"Kant: o que é esclarecimento\",\n        \"pontos\": [\n          \"Esclarecimento: sair da menoridade (falta de coragem, não de idade).\",\n          \"Privado (no cargo): obedece. Público (como estudioso): livre.\",\n          \"Paga o imposto e critica em público: sem contradição.\"\n        ],\n        \"formula\": \"\\\\text{menoridade} \\\\rightarrow \\\\text{esclarecimento: } \\\\textit{Sapere aude!}\",\n        \"pegadinha\": \"Público não é estatal: no cargo, mesmo do governo, é privado.\",\n        \"visual\": {\n          \"tipo\": \"esquema\",\n          \"descricao\": \"Duas caixas: ‘uso privado’ (farda, púlpito, carnê de imposto: obedece) e ‘uso público’ (pena num jornal: critica livremente).\",\n          \"movimento\": [\"A caixa privada aparece com ‘obedece’.\", \"A caixa pública aparece com ‘critica livremente’.\", \"O selo ‘liberdade’ fixa-se só no uso público.\"]\n        }\n      },\n      {\n        \"sub\": \"L07.1\",\n        \"titulo\": \"Razão, progresso e autonomia\",\n        \"pontos\": [\n          \"Razão como critério contra tradição, absolutismo e Igreja.\",\n          \"Autonomia (Kant): obedecer à lei da própria razão.\",\n          \"Inspirou 1776, 1789 (França) e as conjurações Mineira (1789) e Baiana (1798).\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\text{autonomia: lei da própria razão} \\\\\\\\ \\\\times\\\\; \\\\text{heteronomia: lei vinda de fora} \\\\end{gathered}\",\n        \"pegadinha\": \"Autonomia não é fazer o que se deseja.\",\n        \"visual\": {\n          \"tipo\": \"animacao\",\n          \"descricao\": \"Figura empurrada por setas de fora (desejo, medo, ordem) e depois guiada por uma seta que nasce da própria cabeça.\",\n          \"movimento\": [\"As setas de fora empurram a figura: ‘heteronomia’.\", \"Acende uma ‘lei’ dentro da cabeça.\", \"A seta interna guia o passo: ‘autonomia’.\"]\n        }\n      },\n      {\n        \"sub\": \"L07.3\",\n        \"titulo\": \"Voltaire, tolerância e Enciclopédia\",\n        \"pontos\": [\n          \"Tolerância: o Estado não impõe crença. Locke (1689); Voltaire, Tratado sobre a tolerância (1763).\",\n          \"Enciclopédia (1751–1772), de Diderot e d’Alembert: o saber organizado pela razão.\"\n        ],\n        \"pegadinha\": \"Voltaire era deísta, não ateu; a frase “defenderei até a morte” é de 1906.\"\n      }\n    ],\n    \"questao_resolvida\": {\n      \"enunciado\": \"Uma central de atendimento instalou um sistema que mede o tempo de cada ligação e elimina pausas para aumentar a produtividade. A meta chega pronta da diretoria; entre os funcionários, só se discute como cumpri-la, nunca se ela é razoável. À luz da crítica de Adorno e Horkheimer ao esclarecimento, a situação ilustra:\",\n      \"alternativas\": [\n        \"A) a autonomia kantiana, em que cada um dá a si a lei da razão.\",\n        \"B) a razão comunicativa, em que o consenso nasce do diálogo sem coerção.\",\n        \"C) a razão instrumental, que calcula os meios sem discutir os fins.\",\n        \"D) a rejeição de toda razão, defendida pela Escola de Frankfurt.\",\n        \"E) a tolerância, pela qual o poder não impõe crenças.\"\n      ],\n      \"gabarito\": \"C\",\n      \"passos\": [\n        {\"faz\": \"Ler a situação\", \"conta\": \"\\\\begin{gathered} \\\\text{meta vem pronta de cima;} \\\\\\\\ \\\\text{só se discute como cumpri-la} \\\\end{gathered}\", \"mov\": \"A meta desce da diretoria; a palavra ‘como’ acende.\"},\n        {\"faz\": \"Achar a palavra-chave\", \"conta\": \"\\\\text{eficiência sem discutir o fim}\", \"mov\": \"‘Nunca se ela é razoável’ fica em destaque, em amarelo-ouro.\"},\n        {\"faz\": \"Ligar ao conceito\", \"conta\": \"\\\\begin{gathered} \\\\text{calcula meios, não discute fins} \\\\\\\\ =\\\\; \\\\text{razão instrumental} \\\\end{gathered}\", \"mov\": \"Uma seta liga o trecho ao rótulo ‘razão instrumental’.\"},\n        {\"faz\": \"Eliminar as armadilhas\", \"conta\": \"\\\\begin{gathered} \\\\text{risca A: ninguém dá a lei a si} \\\\\\\\ \\\\text{risca B: não há diálogo} \\\\\\\\ \\\\text{risca D: Frankfurt critica o cálculo} \\\\\\\\ \\\\text{risca E: não se fala de crença} \\\\end{gathered}\", \"mov\": \"As quatro alternativas são riscadas uma a uma.\"},\n        {\"faz\": \"Concluir\", \"conta\": \"\\\\text{alternativa C}\", \"mov\": \"A alternativa C acende com borda amarelo-ouro.\"}\n      ],\n      \"por_que_erram\": \"Muitos marcam D por achar que Frankfurt é contra a razão, mas a crítica é à razão reduzida a cálculo de meios.\"\n    },\n    \"conexao\": [\n      {\"materia\": \"História\", \"frase\": \"As ideias iluministas inspiraram a independência das Treze Colônias (1776), a Revolução Francesa (1789) e as conjurações Mineira e Baiana.\"},\n      {\"materia\": \"Sociologia\", \"frase\": \"A indústria cultural de Adorno e Horkheimer (S08.1) é o efeito dialético do esclarecimento aplicado à cultura de massa.\"},\n      {\"materia\": \"Literatura\", \"frase\": \"Em Cândido (1759), Voltaire zomba do otimismo de Leibniz, o melhor dos mundos possíveis.\"}\n    ]\n  },\n  \"pendencias\": [\n    \"O peso de L07.1 foi tratado como média. O slide ‘Como cai na prova’ diz só que cai como pano de fundo, com a UEA 2024; conferir a frequência real.\",\n    \"Marcuse e as falsas necessidades (Enem 2018, Unesp 2021) aparecem só no slide ‘Como cai na prova’, sem slide de conteúdo. Ficaram sem tela; falta material para um tópico próprio.\",\n    \"Teoria crítica (emancipação, distância entre real e possível) e Eclipse da razão ficaram sem tela por corte de tamanho; estão nos slides completos.\",\n    \"A questão Enem 2024 (salões e cafés, Habermas) tem gabarito discutível, conforme as pendências do tema. Por isso não foi usada nem citada nas telas.\",\n    \"Hegel (L07.5) e Foucault (L07.6), propostos nas pendências do tema, não têm conteúdo aprovado e não entraram no essencial.\"\n  ]\n}\n```",
