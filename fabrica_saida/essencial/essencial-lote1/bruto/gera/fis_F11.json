   "text": "```json\n{\n  \"essencial\": {\n    \"termometro\": [\n      {\"sub\": \"F11.2\", \"peso\": \"alta\", \"provas\": \"Fuvest, UFRGS, UFPE, Mackenzie, Unesp, Famerp, Enem\", \"como_cai\": \"Quantas vezes a força muda quando a distância ou as cargas mudam, sentido do campo, ponto de campo nulo e soma vetorial.\"},\n      {\"sub\": \"F11.7\", \"peso\": \"alta\", \"provas\": \"UEPG, Enem, Efomm, Uece, Fuvest, Famerp, Santa Casa\", \"como_cai\": \"Pilha invertida, pilhas em paralelo, gerador real com resistência interna, LED com resistor e Kirchhoff em duas malhas.\"},\n      {\"sub\": \"F11.6\", \"peso\": \"alta\", \"provas\": \"Unicamp, Unesp, Fuvest, Famema, Enem\", \"como_cai\": \"Potência em contexto: lâmpada × chuveiro, kWh e custo, aparelho em outra tensão, efeito Joule aquecendo água.\"},\n      {\"sub\": \"F11.4\", \"peso\": \"alta\", \"provas\": \"Unicamp, Uerj, Enem, Unesp, Fuvest\", \"como_cai\": \"Carga e número de elétrons, bateria em mAh, área do gráfico i × t, curva U × i e 2ª lei de Ohm por proporção.\"},\n      {\"sub\": \"F11.5\", \"peso\": \"alta\", \"provas\": \"PUC-Rio, Enem, Uece, Fuvest\", \"como_cai\": \"Resistência equivalente de figura, lâmpada queimada e brilho, resistor em curto e ponte de Wheatstone.\"},\n      {\"sub\": \"F11.3\", \"peso\": \"media\", \"provas\": \"Fuvest, Unicamp, Unesp, Santa Casa\", \"como_cai\": \"Trabalho τ = q·U, equipotenciais, E·d = U em contexto e potencial de esfera condutora.\"},\n      {\"sub\": \"F11.8\", \"peso\": \"media\", \"provas\": \"Enem, EEAR, UFRGS, Unesp, UFU\", \"como_cai\": \"Medidor ligado errado, fusível, quantos aparelhos cabem sem desarmar o disjuntor e corrente de fuga na casa.\"},\n      {\"sub\": \"F11.9\", \"peso\": \"media\", \"provas\": \"Enem, Fuvest, Unicamp, Uece, UEPG, UEM\", \"como_cai\": \"Q = C·U no desfibrilador, membrana da célula como capacitor, dielétrico, associação e capacitor carregado em circuito.\"},\n      {\"sub\": \"F11.1\", \"peso\": \"baixa\", \"provas\": \"Enem, Fuvest, UFRGS, Unesp\", \"como_cai\": \"Q = n·e, contatos sucessivos entre esferas idênticas, atrito e indução com fio terra.\"}\n    ],\n    \"mapa\": {\n      \"centro\": \"Eletricidade e circuitos\",\n      \"ramos\": [\n        {\"sub\": \"F11.1\", \"titulo\": \"Carga e eletrização\", \"chave\": \"Q = n·e; contato entre idênticas: média das cargas\", \"liga\": [\"F11.2\"]},\n        {\"sub\": \"F11.2\", \"titulo\": \"Coulomb e campo\", \"chave\": \"F = k·|Q|·|q|/d²; E = F/|q|\", \"liga\": [\"F11.1\", \"F11.3\"]},\n        {\"sub\": \"F11.3\", \"titulo\": \"Potencial e condutores\", \"chave\": \"τ = q·U; E·d = U; condutor: E = 0 dentro\", \"liga\": [\"F11.2\", \"F11.4\"]},\n        {\"sub\": \"F11.4\", \"titulo\": \"Corrente e Ohm\", \"chave\": \"U = R·i; R = ρ·L/A; área de i × t é carga\", \"liga\": [\"F11.5\", \"F11.6\"]},\n        {\"sub\": \"F11.5\", \"titulo\": \"Associação de resistores\", \"chave\": \"série: mesma i, R soma; paralelo: mesma U\", \"liga\": [\"F11.6\", \"F11.8\"]},\n        {\"sub\": \"F11.6\", \"titulo\": \"Potência e conta de luz\", \"chave\": \"P = U·i = R·i² = U²/R; E = P·Δt\", \"liga\": [\"F11.5\", \"F11.7\"]},\n        {\"sub\": \"F11.7\", \"titulo\": \"Geradores e Kirchhoff\", \"chave\": \"U = ε − r·i; nós: chega = sai; malha: soma = 0\", \"liga\": [\"F11.5\", \"F11.9\"]},\n        {\"sub\": \"F11.8\", \"titulo\": \"Medidores, fusível e choque\", \"chave\": \"amperímetro em série; voltímetro em paralelo; disjuntor\", \"liga\": [\"F11.5\", \"F11.6\"]},\n        {\"sub\": \"F11.9\", \"titulo\": \"Capacitores\", \"chave\": \"Q = C·U; E = C·U²/2; associação ao contrário\", \"liga\": [\"F11.3\", \"F11.7\"]}\n      ]\n    },\n    \"telas\": [\n      {\n        \"sub\": \"F11.2\",\n        \"titulo\": \"Coulomb e campo elétrico\",\n        \"pontos\": [\n          \"Força: produto das cargas e inverso de d²; cargas em módulo.\",\n          \"Campo E = F/|q|: sai da carga positiva, entra na negativa.\",\n          \"Carga negativa sente força oposta ao campo.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} F = k \\\\cdot \\\\frac{|Q| \\\\cdot |q|}{d^2} \\\\\\\\ E = \\\\frac{F}{|q|} = k \\\\cdot \\\\frac{|Q|}{d^2} \\\\end{gathered}\",\n        \"pegadinha\": \"Dobrou a distância: força 4 vezes menor, não 2.\",\n        \"visual\": {\"tipo\": \"grafico\", \"descricao\": \"Eixos F × d com a curva que cai com 1/d²; carga q desliza de d para 2d e 3d.\", \"movimento\": [\"q em d: ponto em F.\", \"q em 2d: seta cai para um quarto.\", \"q em 3d: seta cai para um nono; curva se desenha.\"]}\n      },\n      {\n        \"sub\": \"F11.7\",\n        \"titulo\": \"Geradores, receptores e Kirchhoff\",\n        \"pontos\": [\n          \"Gerador real: U = ε − r·i; no curto, U = 0.\",\n          \"Receptor: U = ε' + r'·i; rendimento = ε'/U.\",\n          \"Nós: chega = sai. Malha: soma das ddps = 0.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} U = \\\\varepsilon - r \\\\cdot i \\\\\\\\ i = \\\\frac{\\\\sum \\\\varepsilon - \\\\sum \\\\varepsilon'}{R_{\\\\text{total}}} \\\\end{gathered}\",\n        \"pegadinha\": \"Pilha invertida subtrai a f.e.m., mas a resistência interna continua somando.\",\n        \"visual\": {\"tipo\": \"grafico\", \"descricao\": \"Reta U × i descendo de ε até a corrente de curto; ponto de operação desliza.\", \"movimento\": [\"R grande: ponto em (0, ε).\", \"R diminui: ponto desce pela reta.\", \"R = 0: U = 0, corrente máxima.\"]}\n      },\n      {\n        \"sub\": \"F11.6\",\n        \"titulo\": \"Potência, kWh e conta de luz\",\n        \"pontos\": [\n          \"Tensão fixa: menor R, mais potência (chuveiro no inverno).\",\n          \"E = P·Δt, com kW e h dá kWh; 1 kWh = 3,6·10⁶ J.\",\n          \"Aparelho em outra tensão: R fica, P muda com o quadrado de U.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} P = U \\\\cdot i = R \\\\cdot i^2 = \\\\frac{U^2}{R} \\\\\\\\ E = P \\\\cdot \\\\Delta t \\\\end{gathered}\",\n        \"pegadinha\": \"kWh é energia; mAh é carga.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Chuveiro com seletor verão/inverno em 220 V; barra de potência.\", \"movimento\": [\"Verão: R maior, barra média.\", \"Inverno: R menor, barra maior.\", \"Troca para outra tensão: R igual, barra muda com U².\"]}\n      },\n      {\n        \"sub\": \"F11.4\",\n        \"titulo\": \"Corrente, leis de Ohm e resistividade\",\n        \"pontos\": [\n          \"Área sob o gráfico i × t é a carga; 1 A = 1 C/s.\",\n          \"Ôhmico: U = R·i, reta U × i pela origem.\",\n          \"R cresce com L e cai com a área da seção.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} i = \\\\frac{Q}{\\\\Delta t} \\\\qquad U = R \\\\cdot i \\\\\\\\ R = \\\\rho \\\\cdot \\\\frac{L}{A} \\\\end{gathered}\",\n        \"pegadinha\": \"Diâmetro dobra, área quadruplica, R fica 4 vezes menor.\",\n        \"visual\": {\"tipo\": \"grafico\", \"descricao\": \"Gráfico i × t com a área pintada em partes e soma de carga.\", \"movimento\": [\"Retângulo: carga parcial.\", \"Trapézio: soma mais carga.\", \"Área total vira corrente média.\"]}\n      },\n      {\n        \"sub\": \"F11.5\",\n        \"titulo\": \"Associação de resistores\",\n        \"pontos\": [\n          \"Série: mesma corrente; R equivalente é a soma.\",\n          \"Paralelo: mesma ddp; equivalente menor que a menor resistência.\",\n          \"Fio ideal entre dois pontos: resistor entre eles está em curto, sai da conta.\"\n        ],\n        \"formula\": \"R_s = R_1 + R_2 \\\\qquad R_p = \\\\frac{R_1 \\\\cdot R_2}{R_1 + R_2}\",\n        \"pegadinha\": \"Série: maior R brilha mais; paralelo: menor R brilha mais.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Duas lâmpadas de 60 W e 100 W, primeiro em paralelo e depois em série.\", \"movimento\": [\"Paralelo: a de 100 W brilha mais.\", \"Série: a de 60 W brilha mais.\"]}\n      },\n      {\n        \"sub\": \"F11.3\",\n        \"titulo\": \"Potencial, energia e condutores\",\n        \"pontos\": [\n          \"V e Eₚ levam o sinal das cargas e caem com 1/d.\",\n          \"τ = q·U: só a ddp importa, não o caminho.\",\n          \"Campo uniforme: E·d = U.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} \\\\tau_{AB} = q \\\\cdot (V_A - V_B) \\\\\\\\ E \\\\cdot d = U \\\\end{gathered}\",\n        \"pegadinha\": \"Condutor: E = 0 dentro, mas V é igual ao da superfície.\",\n        \"visual\": {\"tipo\": \"esquema\", \"descricao\": \"Placas paralelas com equipotenciais verticais de 100 V a 0 V; carga positiva desce a escada.\", \"movimento\": [\"Linhas de campo aparecem.\", \"Equipotenciais surgem uma a uma.\", \"Carga positiva desce de 100 V a 0 V.\"]}\n      },\n      {\n        \"sub\": \"F11.8\",\n        \"titulo\": \"Medidores, fusíveis e choque\",\n        \"pontos\": [\n          \"Amperímetro em série (R≈0); voltímetro em paralelo (R enorme).\",\n          \"Casa: aparelhos em paralelo; disjuntor em série desarma se P total passar de U·i.\",\n          \"Choque: i = U/R do corpo; pele molhada, mais corrente.\"\n        ],\n        \"formula\": \"P_{\\\\text{máx}} = U \\\\cdot i_{\\\\text{nominal}}\",\n        \"pegadinha\": \"Amperímetro em paralelo vira fio: faz curto.\",\n        \"visual\": {\"tipo\": \"animacao\", \"descricao\": \"Circuito com pilha e lâmpada; amperímetro e voltímetro arrastáveis.\", \"movimento\": [\"Amperímetro em série: lâmpada acesa.\", \"Voltímetro nas pontas da lâmpada: lê a ddp.\", \"Amperímetro em paralelo: lâmpada apaga.\"]}\n      },\n      {\n        \"sub\": \"F11.9\",\n        \"titulo\": \"Capacitores\",\n        \"pontos\": [\n          \"Q = C·U; C depende só de área, distância e dielétrico.\",\n          \"Série: 1/C soma; paralelo: C soma, o contrário dos resistores.\",\n          \"Carregado, o ramo do capacitor não tem corrente.\"\n        ],\n        \"formula\": \"\\\\begin{gathered} Q = C \\\\cdot U \\\\qquad C = \\\\frac{\\\\varepsilon \\\\cdot A}{d} \\\\\\\\ E = \\\\frac{C \\\\cdot U^2}{2} \\\\end{gathered}\",\n        \"pegadinha\": \"Dielétrico: ligado à bateria, U fica; desligado, Q fica.\",\n        \"visual\": {\"tipo\": \"grafico\", \"descricao\": \"Reta Q × U pela origem; área do triângulo pintada é a energia.\", \"movimento\": [\"U sobe, ponto sobe pela reta.\", \"Área se preenche.\", \"Dobrar U: energia 4 vezes maior.\"]}\n      },\n      {\n        \"sub\": \"F11.1\",\n        \"titulo\": \"Carga elétrica e eletrização\",\n        \"pontos\": [\n          \"Q = n·e, com n inteiro; só o elétron se move.\",\n          \"Esferas idênticas em contato ficam com a média das cargas, com sinal.\"\n        ],\n        \"formula\": \"Q = n \\\\cdot e \\\\quad (e = 1{,}6 \\\\cdot 10^{-19}\\\\ \\\\text{C})\",\n        \"pegadinha\": \"Atração não prova sinal oposto (pode ser neutro); só a repulsão prova sinais iguais.\"\n      }\n    ],\n    \"questao_resolvida\": {\n      \"enunciado\": \"Por causa de uma queda de energia, uma família liga um aquecedor de ambiente, cuja etiqueta indica 1 600 W – 200 V, a um gerador portátil que fornece apenas 100 V. Considerando que a resistência do aquecedor não muda, a potência dissipada nessa ligação é de:\",\n      \"alternativas\": [\n        \"A) 6 400 W\",\n        \"B) 1 600 W\",\n        \"C) 800 W\",\n        \"D) 400 W\",\n        \"E) 25 W\"\n      ],\n      \"gabarito\": \"D\",\n      \"passos\": [\n        {\"faz\": \"Tire a resistência da etiqueta, pois ela é o que não muda\", \"conta\": \"R = \\\\frac{U^2}{P} = \\\\frac{200^2}{1\\\\,600} = 25\\\\ \\\\Omega\", \"mov\": \"40 000 dividido por 1 600 vira 25; a etiqueta R fica fixa\"},\n        {\"faz\": \"Calcule a corrente na nova tensão\", \"conta\": \"i = \\\\frac{U'}{R} = \\\\frac{100}{25} = 4\\\\ \\\\text{A}\", \"mov\": \"100 V sobre 25 Ω dá 4 A\"},\n        {\"faz\": \"Calcule a potência nova\", \"conta\": \"P' = U' \\\\cdot i = 100 \\\\cdot 4 = 400\\\\ \\\\text{W}\", \"mov\": \"a barra de potência cai a um quarto\"},\n        {\"faz\": \"Confira pela proporção: a tensão caiu à metade, a potência cai ao quadrado disso\", \"conta\": \"P' = 1\\\\,600 \\\\cdot \\\\left(\\\\frac{100}{200}\\\\right)^2 = \\\\frac{1\\\\,600}{4} = 400\\\\ \\\\text{W}\", \"mov\": \"o fator 1/2 elevado ao quadrado vira 1/4 e corta a barra\"}\n      ],\n      \"por_que_erram\": \"Quem marca 800 W trata a potência como proporcional à tensão; com R fixo, P é proporcional a U², então metade da tensão dá um quarto da potência.\"\n    },\n    \"conexao\": [\n      {\"materia\": \"Biologia\", \"frase\": \"Na eletroforese em gel, o DNA tem carga negativa e anda contra o campo elétrico; a membrana da célula faz papel de capacitor.\"},\n      {\"materia\": \"Química\", \"frase\": \"Pilha e bateria são geradores: transformam energia química em elétrica, e a resistência interna dissipa parte dela em calor.\"},\n      {\"materia\": \"Física (Termologia)\", \"frase\": \"O efeito Joule aquece a água do chuveiro: P·Δt = m·c·Δθ liga potência elétrica e calor.\"}\n    ]\n  },\n  \"pendencias\": [\n    \"F11.1 ficou como peso baixo, com tela curta de 2 tópicos, para o tema fechar em 12 telas; a indução com fio terra e o eletroscópio ficaram fora (continuam nos slides completos).\",\n    \"A conexão está como boxe de 3 frases sob a questão; se o site contar o boxe como tela, o tema chega a 13 telas e basta cortá-lo.\",\n    \"F11.8: faixas de efeito da corrente no corpo não entraram, porque o material não as traz (já registrado nas pendências do tema).\"\n  ]\n}\n```",
